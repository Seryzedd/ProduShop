{% extends 'base.html.twig' %}

{% block title %}
    {% trans %}Schedules{% endtrans %}
{% endblock %}

{% block breadcrumb %}
    {% set breadcrumb = [
        {
            label: 'My account',
            route: 'app_account_informations',
            parameters: []
        },
        {
            label: 'My schedules',
            route: 'app_merchant_schedule',
            parameters: []
        }
    ] %}

    {{ parent() }}
{% endblock %}

{% block body %}
    <main class="container">
        <h1>{% trans %}Schedules{% endtrans %}</h1>

        {{ form_start(form) }}
            <ul class="list-group">
                {% for day in form.scheduleDays %}
                    <li class="list-group-item">
                        <div class="row">
                            <div class="col-md-4">
                                <h4 class="text-primary">{{ day.vars.data.dayName|trans }}</h4>
                            </div>
                            <div class="col-md-8">
                                {% include 'form/collectionType.html.twig' with {'collection': day.hours} %}
                            </div>
                        </div>
                    </li>
                {% endfor %}
            </ul>
            
            <button class="btn btn-primary" type="submit">
                {% trans %}Save{% endtrans %}
            </button>
        {{ form_end(form) }}
    </main>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ importmap('collection-form') }}
    <script src="{{ asset('script/deleteInputValue.js') }}"></script>
    <script src="{{ asset('script/filters.js') }}"></script>
{% endblock %}
