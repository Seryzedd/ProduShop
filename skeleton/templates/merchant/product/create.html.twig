{% extends 'base.html.twig' %}

{% block title %}
    {% trans %}Create new product{% endtrans %}
{% endblock %}

{% block breadcrumb %}
    {% if app.request.attributes.get('_route') == 'app_merchant_product_create' %}
        {% set currentroute = {
            label: 'Create new product',
            route: 'app_merchant_product_create',
        } %}
    {% elseif app.request.attributes.get('_route') == 'app_merchant_product_edit' %}
        {% set currentroute = {
            label: 'Edit "%name%" product'|trans({'%name%': form.vars.data.name}),
            route: 'app_merchant_product_edit',
            parameters: {product: form.vars.data.id}
        } %}
    {% endif %}

    {% set breadcrumb = [
        {
            label: 'My products',
            route: 'app_merchant_products',
        },
        currentroute
    ] %}

    {{ parent() }}
{% endblock %}

{% block body %}
    <main class="container py-4">
        {% if app.request.attributes.get('_route') == 'app_merchant_product_create' %}
            <h1 class="text-secondary">{% trans %}Create new product{% endtrans %}</h1>
        {% elseif app.request.attributes.get('_route') == 'app_merchant_product_edit' %}
            <h1 class="text-secondary">{% trans with {'%name%': form.vars.data.name} %}Edit product "%name%"{% endtrans %}</h1>
        {% endif %}
        
        
        {% set product = form.vars.data %}

        {{ form_start(form) }}
        <div class="row align-items-start">
            
            <div class="col-lg-8">
                <h4 class="mb-3 text-muted">{% trans %}General informations{% endtrans %}</h4>
                
                {{ block('main_informations') }}

                <h4 class="mb-3 text-muted">{% trans %}Packages{% endtrans %}</h4>
                {% include 'form/collectionType.html.twig' with {collection: form.packages} %}
            </div>

            <div class="col-lg-4">
                <h4 class="mb-3 text-muted">{% trans %}Shelf{% endtrans %}</h4>
                {{ form_row(form.shelf) }}

                <h4 class="mb-3 text-muted">{% trans %}Pictures{% endtrans %}</h4>
                <div class="text-center position-relative">
                    {% if product.image == null %}
                        <label class="text-end mx-auto px-2 text-muted" for="{{ form.image.file.vars.id }}">
                            {{ ux_icon('ic:twotone-insert-photo', {height: '48px', width: '48px'}) }}
                        </label>
                    {% elseif product.image|instanceOf('App\\Entity\\Picture') %}
                        <label class="text-end mx-auto px-4 text-muted" for="{{ form.image.file.vars.id }}">
                            <img src="{{ product.image.src }}" alt="{{ product.image.name }}" class="img-fluid">
                        </label>
                        <a class="btn btn-sm btn-light position-absolute top-0 end-0" href="{{ path('app_merchant_product_remove_main_image', {product: product.id}) }}" title="{% trans %}Delete image{% endtrans %}">
                            {{ ux_icon('ic:outline-delete', {height: '20px', width: '20px'}) }}
                        </a>
                    {% endif %}
                </div>
                {{ form_widget(form.image.file) }}
                {{ form_help(form.image.file) }}

                <div class="mt-2 d-flex align-items-center justify-content-center position-relative">
                    {% if form.slider.vars.data %}
                        {% for item in form.slider.vars.data.items %}
                            <img class="img-thumbnail img-fluid" style="max-width: 80px; max-height: 80px;" src="{{ item.image.src }}" alt="{{ item.image.name }}">
                        {% endfor %}

                        <a class="position-absolute btn btn-light btn-sm top-0 end-0" href="{{ path('app_merchant_slider_edit', {slider: form.slider.vars.data.id}) }}">
                            {{ ux_icon('ic:outline-edit', {height: '20px', width: '20px'}) }}
                        </a>
                    {% endif %}
                </div>

                {{ form_label(form.slider) }}
                <div class="d-flex align-items-baseline">
                    <div class="w-100">
                        {{ form_widget(form.slider) }}
                    </div>
                    <a href="{{ path('app_merchant_slider_create') }}" class="btn btn-outline-secondary ms-2" title="{% trans %}Create new slider{% endtrans %}">
                        {{ ux_icon('ic:outline-add', {height: '20px', width: '20px'}) }}
                    </a>
                </div>
                {{ form_help(form.slider) }}
                {{ form_errors(form.slider) }}
            </div>

            <div class="col-lg-12 mt-4">
                <button type="submit" class="btn btn-primary">
                    {% trans %}Save product{% endtrans %}
                </button>
            </div>
        </div>
        {{ form_end(form) }}
    </main>
{% endblock %}

{% block main_informations %}
    <ul class="nav nav-tabs" id="myTab" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="default-tab" data-bs-toggle="tab" data-bs-target="#default-tab-pane" type="button" role="tab" aria-controls="default-tab-pane" aria-selected="true">
                {% trans %}Default{% endtrans %}
            </button>
        </li>
        {% for item in form.translations %}
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="{{ item.vars.data.locale }}-tab" data-bs-toggle="tab" data-bs-target="#{{ item.vars.data.locale }}-tab-pane" type="button" role="tab" aria-controls="{{ item.vars.data.locale }}-tab-pane" aria-selected="false">
                    {{ item.vars.data.locale }}
                </button>
            </li>
        {% endfor %}
        
        <li class="nav-item" role="presentation">
            <div class="dropdown">
                <button class="nav-link text-secondary dropdown-toggle" type="button" title="{% trans %}Add new Translation{% endtrans %}" data-bs-toggle="dropdown" aria-expanded="false">
                    {{ ux_icon('line-md:plus') }}
                </button>
                <ul class="dropdown-menu">
                    {% for enabledLanguage in app.enabled_locales %}
                        <li>
                            <a class="dropdown-item{% if form.vars.data.hasTranslation(enabledLanguage) %} disabled{% endif %}" {% if form.vars.data.hasTranslation(enabledLanguage) %}disabled{% endif %} href="{{ path('app_merchant_product_translation_add', {product: form.vars.data.id, language: enabledLanguage}) }}">
                                {{ enabledLanguage|name }} {{ enabledLanguage|region}}
                            </a>
                        </li>
                    {% endfor %}
                </ul>
            </div>
        </li>
    </ul>
    <div class="tab-content px-3 border-start border-end border-bottom mb-2 rounded-bottom">
        <div class="tab-pane fade show active" id="default-tab-pane" role="tabpanel" aria-labelledby="home-tab" tabindex="0">
            {{ form_row(form.name) }}
            {{ form_row(form.description) }}
        </div>

        {% for item in form.translations %}
            <div class="tab-pane fade" id="{{ item.vars.data.locale }}-tab-pane" role="tabpanel" aria-labelledby="{{ item.vars.data.locale }}-tab" tabindex="0">
                {{ form_row(item.name) }}
                {{ form_row(item.description) }}
            </div>
        {% endfor %}
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ importmap('collection-form') }}
{% endblock %}
    