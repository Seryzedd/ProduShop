{% extends 'base.html.twig' %}

{% block title %}
    {% trans %}My products{% endtrans %}
{% endblock %}

{% block breadcrumb %}
    {% set breadcrumb = [
        {
            label: 'My products',
            route: 'app_merchant_products',
        }
    ] %}

    {{ parent() }}
{% endblock %}

{% block body %}
    <main class="container py-4">
        <div class="d-flex justify-content-between align-items-baseline">
            <h1 class="text-secondary">{% trans %}My products{% endtrans %}</h1>
            <a href="{{ path('app_merchant_product_create') }}" class="btn btn-outline-primary" title="{% trans %}Create new product{% endtrans %}">
                {{ ux_icon('ic:outline-add', {height: '20px', width: '20px'}) }}
            </a>
        </div>
        {{ block('product_list') }}
    </main>
{% endblock %}

{% block product_list %}
    
    {% if app.user.products is empty %}
        <p class="text-center text-muted">{% trans %}You have no products yet.{% endtrans %}</p>
    {% else %}
        <ul class="list-group">
            {% for product in app.user.products %}
                <li class="list-group-item">
                    <div class="row align-items-center">
                        <div class="col-md-2 text-start">
                            {% if product.image and product.image.src|length > 0 %}
                                <img src="{{ product.image.src }}" alt="{{ product.image.name }}" class="w-50 img-thumbnail">
                            {% else %}
                                {{ ux_icon('ic:twotone-broken-image', {width: '50px', height: '50px'}) }}
                            {% endif %}
                        </div>
                        <div class="col-md-2">
                            <a href="{{ path('app_merchant_product_edit', {product: product.id}) }}" >{{ product.name }}</a>
                        </div>
                        <div class="col-md-6">
                            <p class="mb-0 text-muted">{{ product.description }}</p>
                        </div>

                        <div class="col-md-2 text-end">
                            <a class="btn btn-outline-danger" href="{{ path('app_merchant_product_delete', {product: product.id}) }}" title="{% trans %}Delete product{% endtrans %}">
                                {{ ux_icon('ic:outline-delete', {height: '20px', width: '20px'}) }}
                            </a>
                        </div>
                    </div>
                        
                </li>
            {% endfor %}
        </ul>
    {% endif %}
{% endblock %}
