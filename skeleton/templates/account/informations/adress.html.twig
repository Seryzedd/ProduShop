{% extends 'base.html.twig' %}

{% block title %}
    {% trans %}My account{% endtrans %}
{% endblock %}

{% block breadcrumb %}
    {% set breadcrumb = [
        {
            label: 'My account',
            route: 'app_account_informations',
            parameters: []
        },
        {
            label: 'My adress',
            route: app.request.attributes.get('_route'),
            parameters: {adress: form.vars.data.id}
        }
    ] %}
    
    {{ parent() }}
{% endblock %}

{% block body %}
    <main class="container">
        <div class='row'>
            <div class="col-12">
                <h1>{% trans %}My account{% endtrans %}</h1>
            </div>
            
            <div class="col-lg-4">
                {{ block('base_details', "account/informations/index.html.twig") }}
            </div>

            <div class="col-lg-8">
                <h2 class="text-end text-secondary">
                    {% if app.request.attributes.get('_route') == "app_account_new_adress" %}
                        {% trans %}Create adress{% endtrans %}
                    {% else %}
                        {% trans %}My adress{% endtrans %}
                    {% endif %}
                </h2>

                {{ form_start(form, {attr: {class: 'row'}}) }}
                    <div class="col-12">
                        {{ form_label(form.street) }}
                        {{ form_widget(form.street) }}
                        <div class="position-relative">
                            <div id="suggestions" style="display: none;"  class="mb-2"></div>
                        </div>
                        
                        {{ form_help(form.street) }}
                        {{ form_errors(form.street) }}
                    </div>
                    
                    {{ form_row(form.complement, {row_attr: {class: 'col-12  mb-2'}}) }}
                    {{ form_row(form.zipCode, {row_attr: {class: 'col-md-4  mb-2'}}) }}
                    {{ form_row(form.country, {row_attr: {class: 'col-md-8  mb-2'}}) }}

                    <button class="btn btn-primary col-auto ms-auto" type="submit">
                        {% trans %}Validate{% endtrans %}
                    </button>
                {{ form_end(form) }}
            </div>
        </div>
    </main>
{% endblock %}