{% extends 'base.html.twig' %}

{% block title %}
    {% trans %}My account{% endtrans %}
{% endblock %}

{% block breadcrumb %}
    {% set breadcrumb = [
        {
            label: 'My account',
            route: 'app_account_informations',
            parameters: []
        }
    ] %}

    {{ parent() }}
{% endblock %}

{% block body %}
    <main class="container">
        <div class='row'>
            <div class="col-lg-4">
                {{ block('base_details') }}
            </div>

            <div class="col-lg-8">
                <h1 class="text-end text-secondary">{% trans %}My account{% endtrans %}</h1>
            </div>
        </div>
    </main>
{% endblock %}

{% block base_details %}
    <div class="border sticky-top z-1 p-4">
        <h2 class="text-center">
            {% if app.user.logo and app.user.logo.src|length %}
                <img src="{{ app.user.logo.src }}" class="img-fluid img-thumbnail" style="max-width: 100px;">
            {% else %}
                {{ ux_icon('ic:twotone-account-circle', {height: '48px', width: '48px'}) }}
            {% endif %}
            <br>

            {% if is_granted('ROLE_SELLER') %}
                {{ app.user.companyName}}
            {% elseif is_granted('ROLE_USER') %}
                {{ app.user.gender }} {{ app.user.firstName }} {{ app.user.lastName }}
            {% endif %}
        </h2>

        <p class=""><strong class="me-2">{% trans %}Email{% endtrans %} :</strong>{{ app.user.email }}</p>
        {% if is_granted('ROLE_SELLER') %}
            <p class=""><strong class="me-2">{% trans %}Siret{% endtrans %} :</strong>{{ app.user.siret }}</p>
        {% endif %}

        {% if app.user|instanceOf('App\\Entity\\User\\Client') %}
            {{ block('user_details') }}
        {% elseif app.user|instanceOf('App\\Entity\\User\\Professional') %}
            {{ block('professional_details') }}
        {% endif %}

        <ul class="nav flex-column">
            <li class="nav-item text-end">
                <a class="nav-link" href="{{ path('app_account_update') }}">{% trans %}Change my informations{% endtrans %}</a>
            </li>
            <li class="nav-item text-end">
                <a class="nav-link" href="{{ path('app_account_password_update') }}">{% trans %}Update my password{% endtrans %}</a>
            </li>
        </ul>
    </div>
{% endblock %}

{% block main_informations %}
    {% if is_granted('ROLE_SELLER') %}
        {{ block("professional_details") }}
    {% elseif is_granted('ROLE_USER') %}
        {{ block("user_details") }}
    {% endif %}
{% endblock %}

{% block user_details %}
    <div class="position-relative">
        <p class="mb-0 mt-2 d-flex align-items-center justify-content-between">
            <strong>{% trans %}Postale adress{% endtrans %}</strong>
            <a href="{{ path('app_account_adress') }}" class="nav-link w-auto">{{ ux_icon('line-md:pencil-alt-twotone') }}</a>
        </p>
        {% if app.user.shippingAdress|length == 0 %}
            <p class="ms-2 text-muted">
                {% trans %}No postal adress{% endtrans %}
            </p>
        {% endif %}

        {% for adress in app.user.shippingAdress %}
            <p class="ms-2">
                {{ adress.street }}<br>
                {{ adress.zipCode }} {{ adress.country }}
            </p>
        {% endfor %}
    </div>
{% endblock %}

{% block professional_details %}
    <div class="position-relative">
        <p class="mb-0 mt-2 d-flex align-items-center justify-content-between">
            <strong>{% trans %}Postale adress{% endtrans %}</strong>
            <a href="{{ path('app_account_adress') }}" class="nav-link w-auto">{{ ux_icon('line-md:pencil-alt-twotone') }}</a>
        </p>
        {% if app.user.adress %}
            <p class="ms-2">
                {{ app.user.adress.street }}<br>
                {{ app.user.adress.zipCode }} {{ app.user.adress.country }}
            </p>
        {% else %}
            <p class="ms-2 text-muted">
                {% trans %}No postal adress{% endtrans %}
            </p>
        {% endif %}
    </div>
{% endblock %}