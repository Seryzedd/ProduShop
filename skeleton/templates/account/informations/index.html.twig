{% extends 'base.html.twig' %}

{% block title %}
    {% trans %}My account{% endtrans %}
{% endblock %}

{% block breadcrumb %}
    {% set breadcrumb = [
        {
            label: 'My account',
            route: 'app_account_informations',
            parameters: []
        }
    ] %}

    {{ parent() }}
{% endblock %}

{% block body %}
    {% set user = user is defined ? user : app.user %}
    <main class="container">
        <div class='row'>
            <div class="col-lg-4">
                {{ block('base_details') }}
            </div>

            <div class="col-lg-8">
                <h1 class="text-end text-secondary">{% trans %}My account{% endtrans %}</h1>
            </div>
        </div>
    </main>
{% endblock %}

{% block base_details %}
    <div class="border sticky-top z-1 p-4">
        {% if user|instanceOf('App\\Entity\\User\\Client') %}
            {{ block('user_details') }}
        {% elseif user|instanceOf('App\\Entity\\User\\Professional') %}
            {{ block('professional_details') }}
        {% endif %}

        {% if app.user and app.user == user %}
            <ul class="nav flex-column">
                <li class="nav-item text-end">
                    <a class="nav-link" href="{{ path('app_account_update') }}">{% trans %}Change my informations{% endtrans %}</a>
                </li>
                <li class="nav-item text-end">
                    <a class="nav-link" href="{{ path('app_account_password_update') }}">{% trans %}Update my password{% endtrans %}</a>
                </li>
            </ul>
        {% endif %}
    </div>
{% endblock %}

{% block main_informations %}
    {% if is_granted('ROLE_SELLER') %}
        {{ block("professional_details") }}
    {% elseif is_granted('ROLE_USER') %}
        {{ block("user_details") }}
    {% endif %}
{% endblock %}

{% block user_details %}
    <h3 class="text-center">
        {{ user.cleanGender }} {{ user.firstName }} {{ user.lastName }}
    </h3>

    <p class=""><strong class="me-2">{% trans %}Email{% endtrans %} :</strong>{{ user.email }}</p>
    
    <div class="position-relative">
        <p class="mb-0 mt-2 d-flex align-items-center justify-content-between">
            <strong>{% trans %}Postale adress{% endtrans %}</strong>
            <a href="{{ path('app_account_adress') }}" class="nav-link w-auto">{{ ux_icon('line-md:pencil-alt-twotone') }}</a>
        </p>
        {% if user.shippingAdress|length == 0 %}
            <p class="ms-2 text-muted">
                {% trans %}No postal adress{% endtrans %}
            </p>
        {% endif %}

        {% for adress in user.shippingAdress %}
            <p class="ms-2">
                {{ adress.street }}<br>
                {{ adress.zipCode }} {{ adress.country }}
            </p>
        {% endfor %}
    </div>
{% endblock %}

{% block professional_details %}
    {% if user.logo and user.logo.src|length %}
        <img src="{{ user.logo.src }}" class="img-fluid" style="max-width: 100px;">
    {% else %}
        {{ ux_icon('ic:twotone-account-circle', {height: '48px', width: '48px'}) }}
    {% endif %}

    <h3>{{ user.companyName}}</h3>

    <p class=""><strong class="me-2">{% trans %}Siret{% endtrans %} :</strong>{{ user.siret }}</p>

    <div class="position-relative">
        <p class="mb-0 mt-2 d-flex align-items-center justify-content-between">
            <strong>{% trans %}Postale adress{% endtrans %}</strong>
            <a href="{{ path('app_account_adress') }}" class="nav-link w-auto">{{ ux_icon('line-md:pencil-alt-twotone') }}</a>
        </p>
        {% if user.adress %}
            <p class="ms-2">
                {{ user.adress.street }}<br>
                {{ user.adress.zipCode }} {{ user.adress.country }}
            </p>
        {% else %}
            <p class="ms-2 text-muted">
                {% trans %}No postal adress{% endtrans %}
            </p>
        {% endif %}
    </div>
{% endblock %}