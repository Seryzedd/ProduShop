{% extends 'base.html.twig' %}

{% block title %}
    {% trans %}My account{% endtrans %}
{% endblock %}

{% block breadcrumb %}
    {% set breadcrumb = [
        {
            label: 'My account',
            route: 'app_account_informations',
            parameters: []
        }
    ] %}

    {{ parent() }}
{% endblock %}

{% block body %}
    {% set user = user is defined ? user : app.user %}
    <main class="container">
        <h1 class="">{% trans %}My account{% endtrans %}</h1>
        <div class='row'>
            {% if app.user|instanceOf('App\\Entity\\User\\Professional') and app.user.stripeAccount %}
                {% if app.user.stripeAccount.ready == false %}
                    <div class="col-12">
                        <div class="alert alert-warning">
                            <h4>{% trans %}Your account is not completed.{% endtrans %}</h4>
                            <p>{% trans %}Complete it to have your products shown in shelves.{% endtrans %}</p>
                            <a href="#account-complete-link" class="link-secondary link-offset-2 link-underline-opacity-25 link-underline-opacity-100-hover">{% trans %}Complete my account{% endtrans %}</a>
                        </div>
                    </div>
                {% endif %}
            {% endif %}
            <div class="col-lg-4 col-md-6">
                {{ block('base_details') }}
            </div>

            <div class="col-lg-8 col-md-6">
                {% if is_granted('ROLE_SELLER') %}
                    <div class="position-relative">
                        <h3 class="lined mb-0 mt-2 flex-row-reverse justify-content-between">
                            <a href="{{ path('app_merchant_schedule') }}" class="btn btn-light">{{ ux_icon('line-md:pencil-alt-twotone') }}</a>
                            <strong>{% trans %}Schedules{% endtrans %}</strong>
                        </h3>
                        {% if user.openingSchedule %}
                            {{ block('pro_schedules') }}
                        {% else %}
                            <p class="ms-2 text-muted">
                                {% trans %}No Schedules{% endtrans %}
                            </p>
                        {% endif %}
                    </div>
                    {{ block('products') }}
                    {{ block('orders') }}
                {% else %}
                    {{ block('payments') }}
                    {{ block('payment_methods') }}
                {% endif %}
            </div>
        </div>
    </main>
{% endblock %}

{% block base_details %}
    {% if user is not defined %}
        {% set user = app.user %}
    {% endif %}
    <div class="border sticky-top z-1 p-4">
        {% if user|instanceOf('App\\Entity\\User\\Client') %}
            {{ block('user_details') }}
        {% elseif user|instanceOf('App\\Entity\\User\\Professional') %}
            {{ block('professional_details') }}
        {% endif %}

        {% if app.user  %}
            <div>
                {% if app.user == user %}
                    <p class="mb-1">
                        <a class="link-offset-2 link-offset-3-hover link-underline link-underline-opacity-0 link-underline-opacity-75-hover" href="{{ path('app_account_update') }}">{% trans %}Change my informations{% endtrans %}</a>
                    </p>
                    <p class="mb-1">
                        <a class="link-offset-2 link-offset-3-hover link-underline link-underline-opacity-0 link-underline-opacity-75-hover" href="{{ path('app_account_password_update') }}">{% trans %}Update my password{% endtrans %}</a>
                    </p>
                    
                    {% if is_granted('ROLE_SELLER') and (user.stripeAccount == null or user.stripeAccount.ready == false) %}
                        <p class="mb-1">
                            <a  
                                href="{{ path('app_professional_stripe_onboarding') }}"
                                class="link-offset-2 link-offset-3-hover link-underline link-underline-opacity-0 link-underline-opacity-75-hover"
                                id="account-complete-link"
                            >
                                {% trans %}Complete my banking account{% endtrans %}</a>
                        </p>
                    {% endif %}
                {% endif %}
            </div>
        {% endif %}
    </div>
{% endblock %}

{% block user_details %}
    <h3 class="text-center">
        {{ user.cleanGender }} {{ user.firstName }} {{ user.lastName }}
    </h3>

    <p class=""><strong class="me-2">{% trans %}Email{% endtrans %} :</strong>{{ user.email }}</p>

    <p class=""><strong class="me-2">{% trans %}Phone{% endtrans %} :</strong>{{ user.phone ?: 'Not registered' }}</p>

    <div class="position-relative">
        <p class="mb-0 mt-2 d-flex align-items-center justify-content-between">
            <strong>{% trans %}Postal adress{% endtrans %}</strong>
            <a href="{{ path('app_account_adress') }}" class="nav-link w-auto">{{ ux_icon('line-md:pencil-alt-twotone') }}</a>
        </p>
        {% if user.shippingAdress|length == 0 %}
            <p class="ms-2 text-muted">
                {% trans %}No postal adress{% endtrans %}
            </p>
        {% endif %}

        {% for adress in user.shippingAdress %}
            <p class="ms-2">
                {{ adress.street }}<br>
                {{ adress.zipCode }} {{ adress.country }}
            </p>
        {% endfor %}
    </div>
{% endblock %}

{% block professional_details %}
    <h3>
        {% if user.logo and user.logo.src|length %}
            <img src="{{ user.logo.src }}" class="img-fluid" style="max-width: 100px;">
        {% else %}
            {{ ux_icon('ic:twotone-account-circle', {height: '48px', width: '48px'}) }}
        {% endif %}

        {{ user.companyName}}
    </h3>

    <p><strong>{% trans %}Email{% endtrans %}</strong> : <small>{{ user.email }}</small></p>

    <p>
        <strong>{% trans %}Description{% endtrans %} :</strong><br>
        <small class="text-muted">{{ user.description ?: 'Empty description'|trans }}</small>
    </p>

    <p class=""><strong class="me-2">{% trans %}Phone{% endtrans %} :</strong>{{ user.phone ?: 'Not registered' }}</p>

    <p class=""><strong class="me-2">{% trans %}Siret{% endtrans %} :</strong>{{ user.siret }}</p>

    <div class="position-relative">
        <p class="mb-0 mt-2 d-flex align-items-center justify-content-between">
            <strong>{% trans %}Postale adress{% endtrans %}</strong>
            <a href="{{ path('app_account_adress') }}" class="nav-link w-auto">{{ ux_icon('line-md:pencil-alt-twotone') }}</a>
        </p>
        {% if user.adress %}
            <p class="ms-2">
                {{ user.adress.street }}<br>
                {{ user.adress.zipCode }} {{ user.adress.country }}
            </p>
        {% else %}
            <p class="ms-2 text-muted">
                {% trans %}No postal adress{% endtrans %}
            </p>
        {% endif %}
    </div>
{% endblock %}

{% block products %}
    <div class="mb-4">
        <h3 class="lined text-nowrap flex-row-reverse">
            {% trans %}Products{% endtrans %}
        </h3>
        <p class="text-end">
            <a class="link-offset-2 fw-bold link-offset-3-hover link-underline link-underline-opacity-0 link-underline-opacity-75-hover" href="{{ path('app_merchant_product_create') }}">{% trans %}Create{% endtrans %}</a>
            {% if user.products|length > 0 %}
                <a class="link-offset-2 fw-bold link-offset-3-hover link-underline link-underline-opacity-0 link-underline-opacity-75-hover" href="{{ path('app_merchant_stocks') }}">{% trans %}My stocks{% endtrans %}</a>
            {% endif %}
        </p>
        {% if user.products|length > 0 %}
            {% for product in user.products %}
                <div class="row position-relative align-items-center pb-1 pt-1{% if not loop.last %} border-bottom{% endif %}">
                    <div class="col-md-2">
                        {% if product.image %}
                            <img class="img-fluid" src="{{ product.image.src }}" alt="{{ product.image.name }}">
                        {% endif %}
                    </div>

                    <div class="col-md-6">
                        <p class="fw-light mb-0">
                            <a class="stretched-link fw-bold me-3 link-offset-2-hover link-underline link-underline-opacity-0 link-underline-opacity-75-hover" href="{{ path('app_merchant_product_edit', {'product': product.id}) }}">
                                {{ product.name }}
                            </a>
                            <small class="fst-italic">{{ product.shelf.name }}</small>
                            </p>
                        <p class="text-muted fw-bold"><small>{{ product.description }}</small></p>
                    </div>

                    <div class="col-md-4">
                        {% for package in product.packages %}
                            <p class="text-end">
                                <small class="text-muted">x{{ package.quantity }}</small> <strong class="text-secondary">{{ package.finalPrice|number_format(2, ',', ' ') }}€</strong><br>
                                <small class="text-muted">{% trans with {'%quantity%': package.stock} %}x%quantity% in stock{% endtrans %}</small>
                            </p>
                        {% endfor %}
                    </div>
                </div>
            {% endfor %}
        {% else %}
            <p class="text-muted">{% trans %}No products configured{% endtrans %}</p>
        {% endif %}
    </div>
{% endblock %}

{% block pro_schedules %}
    <ul class="list-group list-group-flush">
        {% for day in user.openingSchedule.scheduleDays %}
            <li class="list-group-item">
                <div class="row align-items-center">
                    <div class="col-6 text-dark">
                        {{ day.dayName }}
                    </div>
                    <ul class="list-group list-group-flush col-6">
                        {% for hour in day.hours %}
                            <li class="list-group-item d-flex justify-content-between align-items-center text-muted">
                                {{ '%02d'|format(hour.startHour) }}h{{ '%02d'|format(hour.startMinutes) }}
                                {{ ux_icon('line-md:arrow-right') }}
                                {{ '%02d'|format(hour.endHour) }}h{{ '%02d'|format(hour.endMinutes) }}
                            </li>
                        {% endfor %}
                    </ul>
                </div>
            </li>
        {% endfor %}
    </ul>
{% endblock %}

{% block payments %}
    <h3 class="lined flex-row-reverse">{% trans %}Payments{% endtrans %}</h3>

    {% set limit = 0 %}

    <ul class="list-group list-group-flush">
        {% for payment in user.paymentsByDate %}
            <a href="{{ path('app_account_payment', {payment: payment.id}) }}" class="list-group-item list-group-item-action">
                <div class="row">
                    <div class="col-md-4">
                        {{ payment.createdAt|date('d/m/Y H:i') }}
                    </div>

                    <div class="col-md-4{% if payment.status == 'Pending' %} text-info{% elseif payment.status == 'Treated' %} text-success{% endif %}">
                        {{ payment.status|trans }}
                    </div>
                    <div class="col-md-4 text-end">
                        <strong>{{ (payment.amount / 100)|number_format(2, ',', ' ') }}</strong><small>EUR</small>
                    </div>
                </div>
            </a>
        {% endfor %}
    </ul>
{% endblock %}

{% block orders %}
    <h3 class="lined flex-row-reverse">{% trans %}Orders{% endtrans %}</h3>

    {{ block('order_list') }}
{% endblock %}

{% block order_list %}
    <div class="">
        {% set limit = 0 %}
        
        <ul class="list-group list-group-flush">
            {% for order in user.orders %}
                <a href="" class="list-group-item list-group-item-action">
                    <div class="row">
                        <div class="col-md-4">
                            {{ order.paidAt|date('d/m/Y H:i') }}
                        </div>

                        <div class="col-md-4{% if order.status == 'succeeded' %} text-info{% elseif order.status == 'paid' %} text-success{% endif %}">
                            {{ order.status }}
                        </div>

                        <div class="col-md-4 text-end">
                            {{ (order.amount / 100)|number_format(2, ',', ' ') }}<small>{{ order.currency }}</small>
                        </div>
                    </div>
                </a>
            {% endfor %}
        </ul>
    </div>
{% endblock %}

{% block payment_methods %}
    <div class="mb-4">
        <h3 class="lined flex-row-reverse text-nowrap">{% trans %}Payment methods{% endtrans %}</h3>

        {% for method in paymentMethods %}
            <div class="row align-items-center">
                <div class="col-md-2">
                    {{ method.type }}
                </div>
                <div class="col-md-6">
                    {% trans with {'%createdAt%': method.created|date('d/m/Y H:i')} %}Created at %createdAt%{% endtrans %}
                </div>
                <div class="col-md-4">
                    <p class="mb-0 text-end text-muted">
                        xxxx xxxx xxxx {{ method.card.last4 }}<br>
                        {% trans with {'%month%': method.card.exp_month, '%year%': method.card.exp_year} %}Expire %month%/%year%{% endtrans %}
                    </p>
                </div>
            </div>
        {% endfor %}
    </div>
{% endblock %}