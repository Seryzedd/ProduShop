{% extends 'base.html.twig' %}

{% block title %}
    {% trans %}My account{% endtrans %}
{% endblock %}

{% block breadcrumb %}
    {% set breadcrumb = [
        {
            label: 'My account',
            route: 'app_account_informations',
            parameters: []
        }
    ] %}

    {{ parent() }}
{% endblock %}

{% block body %}
    {% set user = user is defined ? user : app.user %}
    <main class="container">
        <h1 class="">{% trans %}My account{% endtrans %}</h1>
        <div class='row'>
            <div class="col-lg-4 col-md-6">
                {{ block('base_details') }}
            </div>

            <div class="col-lg-8 col-md-6">
                {% if is_granted('ROLE_SELLER') %}
                    {{ block('products') }}
                    {{ block('orders') }}
                {% else %}
                    {{ block('orders') }}
                    {{ block('payment_methods') }}
                {% endif %}
            </div>
        </div>
    </main>
{% endblock %}

{% block base_details %}
    {% if user is not defined %}
        {% set user = app.user %}
    {% endif %}
    <div class="border sticky-top z-1 p-4">
        {% if user|instanceOf('App\\Entity\\User\\Client') %}
            {{ block('user_details') }}
        {% elseif user|instanceOf('App\\Entity\\User\\Professional') %}
            {{ block('professional_details') }}
        {% endif %}

        {% if app.user  %}
            <div>
                {% if app.user == user %}
                    <p class="mb-1">
                        <a class="link-offset-2 link-offset-3-hover link-underline link-underline-opacity-0 link-underline-opacity-75-hover" href="{{ path('app_account_update') }}">{% trans %}Change my informations{% endtrans %}</a>
                    </p>
                    <p class="mb-1">
                        <a class="link-offset-2 link-offset-3-hover link-underline link-underline-opacity-0 link-underline-opacity-75-hover" href="{{ path('app_account_password_update') }}">{% trans %}Update my password{% endtrans %}</a>
                    </p>
                    {% if is_granted('ROLE_SELLER') and not user.stripeAccount.isReady %}
                        <p class="mb-1">
                            <a href="{{ path('app_professional_stripe_onboarding') }}" class="link-offset-2 link-offset-3-hover link-underline link-underline-opacity-0 link-underline-opacity-75-hover">{% trans %}Complete my banking account{% endtrans %}</a>
                        </p>
                    {% endif %}
                {% endif %}
            </div>
        {% endif %}
    </div>
{% endblock %}

{% block user_details %}
    <h3 class="text-center">
        {{ user.cleanGender }} {{ user.firstName }} {{ user.lastName }}
    </h3>

    <p class=""><strong class="me-2">{% trans %}Email{% endtrans %} :</strong>{{ user.email }}</p>

    <p class=""><strong class="me-2">{% trans %}Phone{% endtrans %} :</strong>{{ user.phone ?: 'Not registered' }}</p>

    <div class="position-relative">
        <p class="mb-0 mt-2 d-flex align-items-center justify-content-between">
            <strong>{% trans %}Postale adress{% endtrans %}</strong>
            <a href="{{ path('app_account_adress') }}" class="nav-link w-auto">{{ ux_icon('line-md:pencil-alt-twotone') }}</a>
        </p>
        {% if user.shippingAdress|length == 0 %}
            <p class="ms-2 text-muted">
                {% trans %}No postal adress{% endtrans %}
            </p>
        {% endif %}

        {% for adress in user.shippingAdress %}
            <p class="ms-2">
                {{ adress.street }}<br>
                {{ adress.zipCode }} {{ adress.country }}
            </p>
        {% endfor %}
    </div>
{% endblock %}

{% block professional_details %}
    <h3>
        {% if user.logo and user.logo.src|length %}
            <img src="{{ user.logo.src }}" class="img-fluid" style="max-width: 100px;">
        {% else %}
            {{ ux_icon('ic:twotone-account-circle', {height: '48px', width: '48px'}) }}
        {% endif %}

        {{ user.companyName}}
    </h3>

    <p>
        <strong>{% trans %}Description{% endtrans %} :</strong><br>
        <small class="text-muted">{{ user.description ?: 'Empty description'|trans }}</small>
    </p>

    <p class=""><strong class="me-2">{% trans %}Phone{% endtrans %} :</strong>{{ user.phone ?: 'Not registered' }}</p>

    <p class=""><strong class="me-2">{% trans %}Siret{% endtrans %} :</strong>{{ user.siret }}</p>

    <div class="position-relative">
        <p class="mb-0 mt-2 d-flex align-items-center justify-content-between">
            <strong>{% trans %}Postale adress{% endtrans %}</strong>
            <a href="{{ path('app_account_adress') }}" class="nav-link w-auto">{{ ux_icon('line-md:pencil-alt-twotone') }}</a>
        </p>
        {% if user.adress %}
            <p class="ms-2">
                {{ user.adress.street }}<br>
                {{ user.adress.zipCode }} {{ user.adress.country }}
            </p>
        {% else %}
            <p class="ms-2 text-muted">
                {% trans %}No postal adress{% endtrans %}
            </p>
        {% endif %}
    </div>
{% endblock %}

{% block products %}
    <div class="mb-4">
        <h3 class="lined text-nowrap flex-row-reverse">
            {% trans %}Products{% endtrans %}
        </h3>

        <p class="text-end">
            <a class="link-offset-2 fw-bold link-offset-3-hover link-underline link-underline-opacity-0 link-underline-opacity-75-hover" href="{{ path('app_merchant_stocks') }}">{% trans %}My stocks{% endtrans %}</a>
        </p>

        {% for product in user.products %}
            <div class="row position-relative align-items-center">
                <div class="col-md-2">
                    {% if product.image %}
                        <img class="img-fluid" src="{{ product.image.src }}" alt="{{ product.image.name }}">
                    {% endif %}
                </div>

                <div class="col-md-6">
                    <p class="fw-light mb-0">
                        <a class="stretched-link fw-bold fs-3 link-offset-2-hover link-underline link-underline-opacity-0 link-underline-opacity-75-hover" href="{{ path('app_merchant_product_edit', {'product': product.id}) }}">
                            {{ product.name }}</a>
                            <small class="fst-italic">{{ product.shelf.name }}</small>
                        </p>
                    <p class="text-muted fw-bold"><small>{{ product.description }}</small></p>
                </div>

                <div class="col-md-4">
                    {% for package in product.packages %}
                        <p class="text-end">
                            x{{ package.quantity }} <strong class="text-secondary fs-5">{{ package.finalPrice }}€</strong><br>
                            <small class="text-muted">{% trans with {'%quantity%': package.stock} %}x%quantity% in stock{% endtrans %}</small>
                        </p>
                    {% endfor %}
                </div>
            </div>
        {% endfor %}
    </div>
{% endblock %}

{% block orders %}
    <h3 class="lined flex-row-reverse">{% trans %}Orders{% endtrans %}</h3>

    {{ block('order_list') }}
{% endblock %}

{% block order_list %}
    <div class="list-group list-group-flush mb-4">
        {% for order in user.orders %}
            <a href="{{ path('app_account_order', {id: order.id}) }}" class="list-group-item list-group-item-action">

                <div class="row">
                    <div class="col-md-4">{{ order.paidAt|date('d/m/Y H:i') }}</div>
                    <div class="col-md-2 text-center {% if order.status == 'succeeded' %}text-success{% else %}text-warning{% endif %}">{{ order.status }}</div>
                    <div class="col-md-2 text-center">{% trans with {'%number%': order.orderItems|length} %}%number% products{% endtrans %}</div>
                    <div class="col-md-4 text-secondary text-end"><p class="mb-0">{{ (order.amount / 100)|number_format(2, ',', ' ') }}<small class="">{{ order.currency|upper }}</small></p></div>
                </div>
            </a>
        {% endfor %}
    </div>
{% endblock %}

{% block payment_methods %}
    <div class="mb-4">
        <h3 class="lined flex-row-reverse text-nowrap">{% trans %}Payment methods{% endtrans %}</h3>

        {% for method in paymentMethods %}
            <div class="row align-items-center">
                <div class="col-md-2">
                    {{ method.type }}
                </div>
                <div class="col-md-6">
                    {% trans with {'%createdAt%': method.created|date('d/m/Y H:i')} %}Created at %createdAt%{% endtrans %}
                </div>
                <div class="col-md-4">
                    <p class="mb-0 text-end text-muted">
                        xxxx xxxx xxxx {{ method.card.last4 }}<br>
                        {% trans with {'%month%': method.card.exp_month, '%year%': method.card.exp_year} %}Expire %month%/%year%{% endtrans %}
                    </p>
                </div>
            </div>
        {% endfor %}
    </div>
{% endblock %}