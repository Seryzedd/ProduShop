{% extends 'base.html.twig' %}

{% block breadcrumb %}
    {% set breadcrumb = [
        {
            label: 'Admin Dashboard',
            route: 'app_admin_index',
            parameters: []
        }
    ] %}

    {{ parent() }}
{% endblock %}

{% block admin_menu %}
    <aside class="d-flex align-items-center">
        <ul class="nav flex-column">
            <li class="nav-item">
                <a class="nav-link" aria-current="page" href="#">
                    {{ ux_icon('line-md:home-alt-twotone') }}
                    {% trans %}Admin Homepage{% endtrans %}
                </a>
            </li>
            <li class="nav-item">
                
                <a class="btn btn-primary" data-bs-toggle="collapse" href="#collapseExample" role="button" aria-expanded="false" aria-controls="collapseExample">
                    {{ ux_icon('mdi:google-translate' )}}
                    {% trans %}Languages{% endtrans %}
                </a>

                <div class="collapse" id="collapseExample">
                    <ul class="nav flex-column">
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('app_admin_translations_files') }}">
                                {% trans %}Manager{% endtrans %}
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('app_admin_translations_files') }}">
                                {% trans %}Files{% endtrans %}
                            </a>
                        </li>
                    </ul>
                </div>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="#">
                    {{ ux_icon('mdi:store') }}
                    {% trans %}Products{% endtrans %}
                </a>
            </li>
        </ul>
    </aside>
{% endblock %}