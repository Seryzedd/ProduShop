{% extends 'base.html.twig' %}

{% block title %}
    {% trans %}Users list{% endtrans %}
{% endblock %}

{% block breadcrumb %}
    {% set breadcrumb = [
        {
            label: 'Admin Dashboard',
            route: 'app_admin_index'
        },
        {
            label: 'users',
            route: 'app_admin_users'
        },
        {
            label: '"%email%" view'|trans({'%email%' : user.email}),
            route: 'app_admin_user',
            parameters: {id: user.id}
        }
    ] %}

    {{ parent() }}
{% endblock %}

{% block body %}
    <main class="container">
        <h1>{% trans %}Users list{% endtrans %}</h1>
        
        <div class="row">
            <div class="col-lg-4">
                {{ block('base_details', 'account/informations/index.html.twig') }}
            </div>
            
            <div class="col-lg-8">
                <h3 class="text-end text-secondary lined pt-2">{% trans %}Authorizations{% endtrans %}</h3>
                {{ form_start(form) }}
                    {{ form_row(form.roles) }}
                    <button class="btn btn-primary" type="submit">
                        {% trans %}Save{% endtrans %}
                    </button>
                {{ form_end(form) }}
            </div>
        </div>
    </main>
{% endblock %}