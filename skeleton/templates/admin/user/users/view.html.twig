{% extends 'base.html.twig' %}

{% block title %}
    {% trans %}Users list{% endtrans %}
{% endblock %}

{% block breadcrumb %}
    {% if app.request.attributes.get('_route') == 'app_admin_user' %}
        {% set currentRoute = {
                label: '"%email%" view'|trans({'%email%' : user.email}),
                route: 'app_admin_user',
                parameters: {id: user.id}
            }
        %}
    {% else %}
        {% set currentRoute = {
                label: '"%email%" view'|trans({'%email%' : user.email}),
                route: 'app_admin_email_user',
                parameters: {email: user.email}
            }
        %}
    {% endif %}

    {% set breadcrumb = [
        {
            label: 'Admin Dashboard',
            route: 'app_admin_index'
        },
        {
            label: 'users',
            route: 'app_admin_users'
        },
        currentRoute
    ] %}

    {{ parent() }}
{% endblock %}

{% block body %}
    <main class="container">
        <h1>{% trans %}Users list{% endtrans %}</h1>
        
        <div class="row">
            <div class="col-lg-4">
                {{ block('base_details', 'account/informations/index.html.twig') }}
            </div>
            
            <div class="col-lg-8">
                <h3 class="text-end flex-row-reverse lined pt-2">{% trans %}Authorizations{% endtrans %}</h3>
                {{ form_start(form, {attr: {class: 'mb-4'}}) }}
                    {{ form_row(form.roles) }}
                    <button class="btn btn-primary" type="submit">
                        {% trans %}Save{% endtrans %}
                    </button>
                {{ form_end(form) }}

                {% if user|instanceOf('App\\Entity\\User\\Professional') %}
                    <div class="position-relative">
                        <h3 class="lined mb-0 mt-2 flex-row-reverse justify-content-between">
                            <a href="{{ path('app_merchant_schedule') }}" class="btn btn-light">{{ ux_icon('line-md:pencil-alt-twotone') }}</a>
                            {% trans %}Schedules{% endtrans %}
                        </h3>
                        {% if user.openingSchedule %}
                            {{ block('pro_schedules') }}
                        {% else %}
                            <p class="ms-2 text-muted">
                                {% trans %}No Schedules{% endtrans %}
                            </p>
                        {% endif %}
                    </div>
                    {{ block('products', 'account/informations/index.html.twig') }}
                    {{ block('orders', 'account/informations/index.html.twig') }}
                {% else %}
                    {{ block('payments', 'account/informations/index.html.twig') }}
                    {{ block('payment_methods', 'account/informations/index.html.twig') }}
                {% endif %}
            </div>
        </div>
    </main>
{% endblock %}
