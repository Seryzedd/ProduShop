{% extends 'base.html.twig' %}

{% block title %}{% trans with {'%lang%': locale|language} %}Translations in %lang%{% endtrans %}{% endblock %}

{% block breadcrumb %}
    {% set breadcrumb = [
        {
            label: 'Admin Dashboard',
            route: 'app_admin_index',
            parameters: []
        },
        {
            label: 'Translations',
            route: 'app_admin_translations_manager',
            parameters: []
        },
        {
            label: 'Translations in %lang%',
            route: 'app_admin_translations_manager_edit',
            parameters: {'locale': locale},
            translationKey: {'%lang%': locale|language}
        }
    ] %}

    {{ parent() }}
{% endblock %}

{% block body %}
    <main class="container p-4">
        <div class="row align-items-center">
            <h1 class="col-sm-10">
                {% trans with {'%lang%': locale|language} %}Translations in %lang%{% endtrans %}
                <small class="fs-4">{{ locale|region }}</small>
                <small class="fs-6 fw-lighter">({{ locale }})</small>
            </h1>
            <div class="col-sm-2 text-end">
                <a class="btn btn-primary btn-sm spin-hover" href="{{ path('app_admin_translations_manager_reload', {'locale': locale}) }}">
                    {{ ux_icon('ic:twotone-autorenew', {height: '26px', width: '26px'}) }}
                </a>
            </div>
        </div>

        {% include 'components/filters/filter_by_input_val.html.twig' with {'value': 'translations'|trans, 'container': '.translations-form'} %}

        <ul class="nav nav-tabs justify-content-end" role="tablist">
            {% for file in languages.languages %}
                
                <li class="nav-item">
                
                    <button class="nav-link{% if (activeFile == null and loop.first) or (file.filename == activeFile) %} active{% endif %}" id="{{ file.provider }}-tab" data-bs-toggle="tab" data-bs-target="#{{ file.provider }}-tab-pane" type="button" role="tab" aria-controls="{{ file.provider }}-tab-pane" aria-selected="{% if (activeFile == null and loop.first) or (file.filename == activeFile) %}true{% else %}false{% endif %}">{{ file.provider }}</button>
                </li>
            {% endfor %}
        </ul>

        {% set prototypeHtml = form_widget(prototypeForm.translations.vars.prototype) %}
        <div class="tab-content translations-form" id="pills-tabContent">
            {% for languageFile in languages.languages %}
                <div role="tabpanel" class="tab-pane border-end border-start border-bottom p-4 fade{% if (activeFile == null and loop.first) or (languageFile.filename == activeFile) %} show active{% endif %}" id="{{ languageFile.provider }}-tab-pane" aria-labelledby="{{ languageFile.provider }}-tab" tabindex="{{ loop.index }}">

                    <h5 class="text-secondary">{{ languageFile.filename }}</h5>

                    {% set holderClass = languageFile.filename|replace({'.': '-'}) ~ '-collection' %}
                    <form method="POST" action="" class="translations-form">
                        <ul class="list-group list-group-flush {{holderClass}}"
                            data-index="{{ languageFile.translations|length + 1 }}"
                            data-filename="{{ languageFile.filename }}"
                            data-collection-holder-class="{{holderClass}}"
                            data-prototype="
                                <div class=&quot;row align-items-start mt-2&quot;>
                                    <div class=&quot;col-lg-6&quot;>
                                        <label>{{ 'Translation key'|trans }}</label>
                                        <input type=&quot;text&quot; class=&quot;form-control mb-2 mb-lg-0&quot; name=&quot;translations[{{ languageFile.filename }}][__name__][translationKey]&quot; placeholder=&quot;{{ 'New key'|trans }}&quot;>
                                    </div>
                                    <div class=&quot;col-lg-6&quot;>
                                        <label>{{ 'Translation value'|trans }}</label>
                                        <input type=&quot;text&quot; class=&quot;form-control&quot; name=&quot;translations[{{ languageFile.filename }}][__name__][translationValue]&quot; placeholder=&quot;{{ 'Translated value'|trans }}&quot;>
                                    </div>
                                </div>
                            "
                        >
                            {% for translation in languageFile.translations %}
                                <li class="list-group-item">
                                    <button type="button" class="btn btn-ouline-danger remove_collection_item_btn btn-trash position-absolute top-0 end-0 p-2 rounded-start-0"></button>
                                    <div class="row align-items-start mt-2">
                                        <div class="col-lg-6">
                                            <label for="translation_key_{{ loop.index }}">{% trans %}Translation key{% endtrans %}</label>
                                            <input type="hidden" name="translations[{{ languageFile.filename }}][{{ loop.index }}][translationKey]" value="{{ translation.translationKey }}">
                                            <input type="text"
                                                id="translation_key_{{ loop.index }}"
                                                class="form-control mb-2 mb-lg-0 disabled"
                                                value="{{ translation.translationKey }}"
                                                readonly
                                            >
                                        </div>
                                        <div class="col-lg-6">
                                            <label for="translation_value_{{ loop.index }}">{% trans %}Translation value{% endtrans %}</label>
                                            <input type="text"
                                                id="translation_value_{{ loop.index }}"
                                                class="form-control"
                                                name="translations[{{ languageFile.filename }}][{{ loop.index }}][translationValue]"
                                                value="{{ translation.translationValue }}"
                                            >
                                        </div>
                                    </div>
                                </li>
                            {% endfor %}
                        </ul>

                        <p class="text-end">
                            <button type="button" class="add_collection_item_btn btn btn-outline-secondary btn-sm" data-collection-holder-class="{{ holderClass }}">
                                {% trans %}Add new{% endtrans %}
                                {{ ux_icon('ic:outline-add', {height: '20px', width: '20px'}) }}
                            </button>
                        </p>

                        <input type="hidden" name="_token" value="{{ csrf_token('translations_edit') }}">

                        <button type="submit" class="btn btn-primary mt-2">
                            {% trans %}Save{% endtrans %}
                        </button>
                    </form>
                </div>
            {% endfor %}
        </div>
    </main>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ importmap('collection-form') }}
    <script src="{{ asset('script/deleteInputValue.js') }}"></script>
    <script src="{{ asset('script/filters.js') }}"></script>
{% endblock %}
