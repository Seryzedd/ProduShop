{% extends 'base.html.twig' %}

{% block title %}
    {% trans %}Translations files{% endtrans %}
{% endblock %}

{% block breadcrumb %}
    {% set breadcrumb = [
        {
            label: 'Admin Dashboard',
            route: 'app_admin_index',
            parameters: []
        },
        {
            label: 'Translations',
            route: 'app_admin_translations_manager',
            parameters: []
        },
        {
            label: 'Translations files',
            route: 'app_admin_translations_files',
            parameters: []
        }
    ] %}

    {{ parent() }}
{% endblock %}

{% block body %}
    <main class="container">
        <div class="d-flex justify-content-between align-items-end mb-1">
            <h1>{% trans %}Translation files{% endtrans %}</h1>

            <div class="col-auto btn-group">
                <button type="button" class="btn btn-primary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                    {{ ux_icon('ic:outline-add', {height: '20px', width: '20px'}) }}
                </button>
                <ul class="dropdown-menu" style="max-height: 300px; overflow-y: auto;">
                    {% for language in languages %}
                        <li>
                            <a class="dropdown-item py-2" href="{{ path('app_admin_translations_manager_extract', {locale: language}) }}">{{ language|name }} {{ language|region }}</a>
                        </li>
                    {% endfor %}
                </ul>
            </div>
        </div>

        <ul class="list-group">
            {% if locale %}
                <p class="text-muted">{% trans with {'%language%': locale|name} %}Translations files in %language%{% endtrans %}<small>{{ locale|region }}</small></p>
                {% for file in files.languages %}
                    <li class="list-group-item">
                         <nav class="nav flex-column">
                            <div class="d-flex align-items-center justify-content-between mb-1">
                                <a class="nav-link" href="{{ path('app_admin_translations_file_download', {'filename': file.filename}) }}">
                                    {{ ux_icon('line-md:file-download', {width: '24px', height: '24px'}) }}
                                    {{ file.filename }}
                                </a>

                                <div class="justify-content-end d-flex px-2">
                                    <a class="btn btn-outline-dark btn-sm me-2" href="{{ path('app_admin_translations_file_manager_edit', {'locale': locale, 'filename': file.filename}) }}">
                                        {{ ux_icon('line-md:pencil-alt-twotone' )}}
                                    </a>
                                    <a class="btn btn-outline-danger btn-sm" href="{{ path('app_admin_translations_file_delete', {'filename': file.filename}) }}">
                                        {{ ux_icon('line-md:trash')}}
                                    </a>
                                </div>
                            </div>
                        </nav>
                    </li>
                {% endfor %}
            {% else %}
                {% for language, languagefiles in files %}
                    <li class="list-group-item">
                        <p class="mb-0 text-muted">
                            {{ language|language }}<small class="ms-2">{{ language|region }}</small>
                            <a class="btn btn-light btn-sm text-end" href="{{ path('app_admin_translations_manager_edit', {'locale': language}) }}">
                                {{ ux_icon('line-md:pencil-alt-twotone' )}}
                            </a>
                        </p>
                   
                        <nav class="nav flex-column">
                            {% for file in languagefiles %}
                                <div class="d-flex border-bottom align-items-center justify-content-between mb-1">
                                    <a class="nav-link" href="{{ path('app_admin_translations_file_download', {'filename': file.filename}) }}">
                                        {{ ux_icon('line-md:file-download', {width: '24px', height: '24px'}) }}
                                        {{ file.filename }}
                                    </a>

                                    <div class="justify-content-end d-flex px-2">
                                        <a class="btn btn-outline-dark btn-sm me-2" href="{{ path('app_admin_translations_file_manager_edit', {'locale': language, 'filename': file.filename}) }}">
                                            {{ ux_icon('line-md:pencil-alt-twotone' )}}
                                        </a>
                                        <a class="btn btn-outline-danger btn-sm" href="{{ path('app_admin_translations_file_delete', {'filename': file.filename}) }}">
                                            {{ ux_icon('line-md:trash')}}
                                        </a>
                                    </div>
                                </div>
                            {% endfor %}
                        </nav>
                    </li>
                {% endfor %}
            {% endif %}
        </ul>
        
    </main>
{% endblock %}