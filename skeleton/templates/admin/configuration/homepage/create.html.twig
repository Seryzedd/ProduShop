{% extends 'base.html.twig' %}

{% block title %}
    {% trans %}Admin homepage block configuration{% endtrans %}
{% endblock %}

{% block breadcrumb %}
    {% set params = [] %}
    {% if app.request.attributes.get('_route') == 'app_admin_configuration_homepage_update' %}
        {% set label = 'Update homepage block "%id%"' %}
        {% set params = {'block': form.vars.data.id} %}
        {% set translations = {'%id%': form.vars.data.id} %}
    {% else %}
        {% set label = 'app_admin_configuration_homepage_new' %}
        {% set translations = [] %}
    {% endif %}
    {% set breadcrumb = [
        {
            label: 'Admin Dashboard'|trans,
            route: 'app_admin_index'
        },
        {
            label: 'Homepage configuration'|trans,
            route: 'app_admin_configuration_homepage'
        },
        {
            label: label,
            route: app.request.attributes.get('_route'),
            parameters: params,
            translationKey: translations
        }
    ] %}

    {{ parent() }}
{% endblock %}

{% block body %}
    <main class="container">
        <div class="d-flex justify-content-between align-items-end">
            <h1>{% trans %}Block manager{% endtrans %}</h1>
        </div>
        {{ form_start(form) }}
            <div class="row align-items-center">
                <div class="col-12 text-end">
                    {{ form_row(form.active) }}
                </div>

                <div class="col-lg-4">
                    {{ form_row(form.type) }}
                </div>

                <div class="col-lg-4">
                    {{ form_row(form.backgroundColor) }}
                </div>
                
                
                <div class="col-lg-4 text-center">
                    {{ form_row(form.backgroundImage) }}
                </div>

                <div class="col-12">
                    {% set collection = form.htmlElement %}

                    {{ form_label(collection) }}

                    <ul class="{{ collection.vars.name }}-collection list-group list-group"
                        {% if collection.vars.prototype is defined %}
                            data-prototype="{{ form_widget(collection.vars.prototype)|e('html_attr') }}"
                        {% endif %}
                        deletable="{{ collection.vars.allow_delete }}"
                        data-index="{{ collection|length > 0 ? collection|length + 1 : 0 }}"
                        {% if formInline is defined %}
                            data-inline-items="{{ formInline ? 'true' : 'false' }}"
                        {% endif %}
                    >
                        {% for item in collection %}
                            <li class="list-group-item">
                                {% if collection.vars.prototype is defined %}
                                    <div class="position-absolute top-0 end-0">
                                        <a href="{{ path('app_admin_configuration_homepage_translate', {text: item.vars.data.id}) }}" class="link-dark link-underline-opacity-0 link-dark-">{{ ux_icon('ic:outline-language') }}</a>
                                        <button type="button" class="btn btn-ouline-danger remove_collection_item_btn btn-trash p-2 rounded-start-0"></button>
                                    </div>
                                {% endif %}
                                
                                {{ form_row(item) }}
                            </li>
                        {% endfor %}
                    </ul>

                    {% if collection.vars.allow_add %}
                        <p class="text-end">
                            <button type="button" class="add_collection_item_btn btn btn-outline-secondary btn-sm" data-collection-holder-class="{{ collection.vars.name }}-collection">
                                {% trans %}Add new{% endtrans %}
                                {{ ux_icon('ic:outline-add', {height: '20px', width: '20px'}) }}
                            </button>
                        </p>
                    {% endif %}

                    {% do collection.setRendered %}
                </div>
            </div>
            

            <button type="submit" class="btn btn-primary">
                {% trans %}Update{% endtrans %}
            </button>
        {{ form_end(form) }}
    </main>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ importmap('collection-form') }}
{% endblock %}