{% extends 'base.html.twig' %}

{% block title %}
    {% trans with {'%id%': payment.id} %}Payment "%id%"{% endtrans %}
{% endblock %}

{% block breadcrumb %}
    {% set breadcrumb = [
        {
            label: 'Admin Dashboard'|trans,
            route: 'app_admin_index',
            parameters: []
        },
        {
            label: 'Payments'|trans,
            route: 'app_admin_payments_stripe',
            parameters: []
        },
        {
            label: 'Payment "%id%"'|trans({'%id%': payment.id}),
            route: 'app_admin_payment_stripe',
            parameters: {id: payment.id}
        }
    ] %}

    {{ parent() }}
{% endblock %}

{% block body %}
    <main class="container mb-3">
        <h1>{% trans %}Payment details{% endtrans %}</h1>
        <div class="d-flex justify-content-between">
            <div>
                <p class="text-muted">{{ payment.id }}</p>
                <p class="mb-0">{{ payment.created|date('l d F Y H:i') }}</p>
            </div>
            
            <div>
                <h4 class="text-end text-secondary mb-0"><strong>{{ (payment.amount / 100)|number_format(2, ',', ' ') }}</strong>{{ payment.currency }}</h4>
                <p class="text-end text-muted mb-0">{% trans with {'%amount%': (payment.application_fee_amount / 100)|number_format(2, ',', ' ')} %}fees %amount%{% endtrans %}</strong>{{ payment.currency }}</p>
            </div>
            
        </div>

        <div class="card p-4">
            <div class="row align-items-center">
                <div class="col-12">
                    {% if payment.status == "succeeded" %}
                        <p class="text-end text-success">{{ payment.status }}</p>
                    {% elseif payment.status == "requires_confirmation" %}
                        <p class="text-end text-info">{{ payment.status }}</p>
                    {% endif %}
                </div>

                <div class="col-lg-5 position-relative card p-3">
                    <h5 class="text-muted">{% trans %}Customer{% endtrans %} :</h5>

                    <p>{% trans %}Paid{% endtrans %} : <strong>{{ (payment.amount / 100)|number_format(2, ',', ' ') }}</strong>{{ payment.currency }}<br>
                        <a href="{{ path('app_admin_email_user', {email: payment.customer.email}) }}" class="link-offset-2 stretched-link link-offset-3-hover link-underline link-underline-opacity-0 link-underline-opacity-75-hover">
                            <strong class="text-primary">{{ payment.customer.name }}</strong><br>
                            {{ payment.customer.email }}
                        </a><br>
                        <code>{{ payment.customer.id }}</code>
                    </p>
                    

                    <p class="mb-0">
                        {{ payment.payment_method.card.brand }}<br>
                        <small class="text-muted">
                            xxxx xxxx xxxx {{ payment.payment_method.card.last4 }}
                            {% trans with {'%month%': payment.payment_method.card.exp_month, '%year%': payment.payment_method.card.exp_year} %}Expire at %month%/%year%{% endtrans %}
                        </small>
                    </p>
                </div>

                <div class="col-lg-2">
                    <p class="text-center mb-0">
                        {{ ux_icon('line-md:arrow-right') }}
                    </p>
                </div>

                <div class="col-lg-5 card position-relative p-3">
                    <h5 class="text-muted">{% trans %}Merchant{% endtrans %} :</h5>

                    {% if payment.transfer_data %}
                        <p>{% trans %}Received{% endtrans %} : <strong>{{ ((payment.amount - payment.application_fee_amount) / 100)|number_format(2, ',', ' ') }}</strong>{{ payment.currency }}</p>
                        <p class="mb-0">
                            <strong class="text-primary">{{ payment.transfer_data.destination.individual.first_name }} {{ payment.transfer_data.destination.individual.last_name }}</strong>
                        </p>
                        <p class="mb-0">{{ payment.transfer_data.destination.email }}</p>
                        <code class="">{{ payment.transfer_data.destination.id }}</code>

                        {% for bank in payment.transfer_data.destination.external_accounts.data %}
                            <p class="text-muted mt-2">
                                <small>
                                    {{ bank.bank_name }}<br>
                                    xxxx xxxx xxxx {{ bank.last4 }}
                                </small>
                            </p>
                        {% endfor %}
                    {% else %}
                        {% trans %}Account is not ready{% endtrans %}
                    {% endif %}
                </div>
            </div>
        </div>
    </main>
{% endblock %}