{% extends 'base.html.twig' %}

{% block title %}
    {% trans with {'%id%': payment.id} %}Payment "%id%"{% endtrans %}
{% endblock %}

{% block breadcrumb %}
    {% set breadcrumb = [
        {
            label: 'Admin Dashboard'|trans,
            route: 'app_admin_index',
            parameters: []
        },
        {
            label: 'Payments'|trans,
            route: 'app_admin_payments_stripe',
            parameters: []
        },
        {
            label: 'Payment "%id%"'|trans({'%id%': payment.id}),
            route: 'app_admin_payment_stripe',
            parameters: {id: payment.id}
        }
    ] %}

    {{ parent() }}
{% endblock %}

{% block body %}
    <main class="container mb-3">
        <div class="d-flex justify-content-between align-items-end">
            <h1>{% trans %}Payment details{% endtrans %}</h1>

            {% if payment.status == "succeeded" %}
                <p class="text-end text-success">{{ payment.status|upper }}</p>
            {% else %}
                <p class="text-end text-info">{{ payment.status|upper }}</p>
            {% endif %}
        </div>
        
        <div class="d-flex justify-content-between">
            <div>
                <p class="text-muted">{{ payment.id }}</p>
                <p class="mb-0">{{ payment.created|date('l d F Y H:i') }}</p>
            </div>
            
            <div>
                <h4 class="text-end text-secondary mb-0"><strong>{{ (payment.amount / 100)|number_format(2, ',', ' ') }}</strong>{{ payment.currency }}</h4>
                <p class="text-end text-muted mb-0">{% trans with {'%amount%': (payment.application_fee_amount / 100)|number_format(2, ',', ' ')} %}fees %amount%{% endtrans %}</strong>{{ payment.currency }}</p>
            </div>
            
        </div>

        <div class="card p-4">
            <div class="row align-items-center">
                <div class="col-12 card mb-2 p-4">
                    <h5 class="lined text-dark flex-row-reverse">
                        {% trans %}Description{% endtrans %}
                    </h5>
                    <p class="ps-4 text-muted fst-italic">
                        {{ payment.description }}
                    </p>
                </div>

                <div class="col-lg-5 position-relative card p-3">
                    <h5 class="text-muted">{% trans %}Customer{% endtrans %} :</h5>

                    <p>
                        <a href="{{ path('app_admin_email_user', {email: payment.customer.email}) }}" class="link-offset-2 stretched-link link-offset-3-hover link-underline link-underline-opacity-0 link-underline-opacity-75-hover">
                            <strong class="text-primary">{{ payment.customer.name }}</strong><br>
                            {{ payment.customer.email }}
                        </a><br>
                        <code>{{ payment.customer.id }}</code>
                    </p>
                    

                    <p class="mb-0">
                        {{ payment.payment_method.card.brand }}<br>
                        <small class="text-muted ps-4">
                            xxxx xxxx xxxx {{ payment.payment_method.card.last4 }}
                            {% trans with {'%month%': payment.payment_method.card.exp_month, '%year%': payment.payment_method.card.exp_year} %}Expire at %month%/%year%{% endtrans %}
                        </small>
                    </p>
                </div>

                <div class="col-lg-2">
                    <p class="text-center mb-0">
                        {{ ux_icon('line-md:arrow-right') }}
                    </p>
                </div>

                <div class="col-lg-5 card position-relative p-3">
                    <h5 class="text-muted">{% trans %}Merchants{% endtrans %} :</h5>
                    
                    {% set account = payment.transfer_data.destination %}
                    <div>
                        <p class="">
                            <strong>{% trans %}Created at{% endtrans %} :</strong>
                            {{ account.created|date('d/m/Y') }}
                        </p>
                        <p class=""><strong>{% trans %}Account id{% endtrans %} : </strong><code>{{ account.id }}</code></p>
                        <p class="mb-0"><strong>{% trans %}Name{% endtrans %} : </strong>{{ account.name ?? 'No name'|trans }}</p>
                        <p class="mb-0">
                            <strong>{% trans %}Email{% endtrans %} : </strong>
                            <a class="link-offset-2 link-offset-3-hover stretched-link link-underline link-underline-opacity-0 link-underline-opacity-75-hover" href="{{ path('app_admin_email_user', {email: account.email}) }}">{{ account.email }}</a>
                        </p>
                        <p class="mb-0"><strong>{% trans %}Phone{% endtrans %} : </strong>{{ account.company.phone }}</p>

                        <div>
                            <p>
                                <strong>{% trans %}Adress{% endtrans %} :</strong>
                                {{ account.company.address.line1 }},
                                {{ account.company.address.postal_code }} {{ account.company.address.city }}
                            </p>
                        </div>

                        <div>
                            <strong>{% trans %}Bank{% endtrans %} :</strong>
                            {% for bank in account.external_accounts.data %}
                                <p class="mb-0 ps-4">{{ bank.bank_name|capitalize }}</p>
                                <p class="text-muted ps-4">xxxx xxxx xxxx{{ bank.last4 }}</p>
                            {% endfor %}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>
{% endblock %}