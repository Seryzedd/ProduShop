{% extends 'base.html.twig' %}

{% block title %}
    {% trans %}Admin Dashboard{% endtrans %}
{% endblock %}

{% block breadcrumb %}
    {% set breadcrumb = [
        {
            label: 'Admin Dashboard',
            route: 'app_admin_index',
            parameters: []
        }
    ] %}

    {{ parent() }}
{% endblock %}

{% block body %}
    <main class="container">
        <h1 class="text-primary">{% trans %}Admin dashboard{% endtrans %}</h1>
        
        <div class="row align-items-center">
            <div class="col-md-6 offset-md-3 px-4 position-relative text-center">
                {{ block('users_block') }}
            </div>

            {% if regionClientPercent|length > 0 %}
                <div class="col-md-6 col-lg-4 offset-lg-2 px-4 py-4 position-relative text-center">
                    {{ block('region_client_block') }}
                </div>
            {% endif %}

            {% if regionProPercent|length > 0 %}
                <div class="col-md-6 col-lg-4 px-4 py-4 position-relative text-center">
                    {{ block('region_pro_block') }}
                </div>
            {% endif %}

            <div class="col-md-6 col-lg-4 px-4 py-4 position-relative text-center">
                {{ block('payments_block') }}
            </div>

            <div class="col-md-6 col-lg-4 px-4 py-4 position-relative text-center">
                {{ block('products_block') }}
            </div>

            <div class="col-md-6 col-lg-4 px-4 py-4 position-relative text-center">
                {{ block('translations_block') }}
            </div>
        </div>
    <main>
{% endblock %}


{% block payments_block %}
    {% set total = 0 %}
    {% set count = 0 %}
    {% for payment in paymentStats %}
        {% set total = total + payment.total %}
        {% set count = count + payment.count %}
    {% endfor %}
    <div class="d-flex align-items-baseline justify-content-center">
        <h2 class="text-secondary number-float-animation"  data-end="{{ total / 100 }}"><span>0</span><small>{{ ux_icon('ic:round-euro', {width: '14px', height: '14px'}) }}</small></h2>
        <p class="mb-0 text-muted fst-italic">
            /{% trans %}Payment{% endtrans %}
        </p>
    </div>
    <a href='{{ path('app_admin_payments') }}' class="stretched-link fs-4 link-underline-primary link-underline-opacity-0 link-opacity-50-hover">{% trans with {'%count%': count} %}{1}%count% payment|]1,Inf]%count% payments{% endtrans %}</a>

    {% for payment in paymentStats %}
        {% set pct = payment.total|percentage(total) %}
        <p class="text-end mb-0"><small>{{ payment.status|replace({'ROLE_': ''})|lower|capitalize|trans }} : {{ pct|number_format(2, ',', ' ') }}%</small></p>
        <p class="progress-percent-bar text-muted" style="--pct:{{ pct }}%; --delay:{{ loop.index * 0.15 }}s"></p>
    {% endfor %}
{% endblock %}

{% block users_block %}
    <h2 class="text-secondary number-animation" style="--end:{{ usersStats.total }}"></h2>
    <a href="{{ path('app_admin_users') }}" class="stretched-link fs-4 link-underline-primary link-underline-opacity-0 link-opacity-50-hover">{% trans %}Users{% endtrans %}</a>

    {% for role, count in usersStats.by_role %}
        {% set pct = count|percentage(usersStats.total) %}
        <p class="text-end mb-0"><small>{{ role|replace({'ROLE_': ''})|lower|capitalize|trans }} : {{ pct }}%</small></p>
        <p class="progress-percent-bar text-muted" style="--pct:{{ pct }}%; --delay:{{ loop.index * 0.15 }}s"></p>
    {% endfor %}
{% endblock %}

{% block products_block %}
    <div class="d-flex justify-content-center align-items-end">
        <h2 class="text-secondary number-float-animation mb-0" data-end="{{ productsStats.avg_price }}"><span>0</span><small>{{ ux_icon('ic:round-euro', {width: '14px', height: '14px'}) }}</small></h2>
        <p class="mb-0 text-muted fst-italic">
            /{% trans %}Product{% endtrans %}
        </p>
    </div>
    
    <a href="{{ path('app_admin_product_shelf') }}" class="stretched-link fs-4 link-underline-primary link-underline-opacity-0 link-opacity-50-hover">{% trans with {'%count%': productsStats.total} %}{1}%count% product|]1,Inf]%count% products{% endtrans %}</a>

    {% for shelf in productsStats.by_shelf %}
        {% set pct = shelf.total|percentage(productsStats.total) %}
        <p class="text-end mb-0"><strong class="me-1">{{ shelf.total }}</strong><small>{{ shelf.shelf|capitalize }} : {{ shelf.avg_price|number_format(2, ',', ' ') }}{{ ux_icon('ic:round-euro', {width: '12px', height: '12px'}) }}</small></p>
        <p class="progress-percent-bar text-muted" style="--pct:{{ pct }}%; --delay:{{ loop.index * 0.15 }}s"></p>
    {% endfor %}
{% endblock %}

{% block translations_block %}
    {% set fileTotal = 0 %}
    {% for file in translations %}
        {% set fileTotal = fileTotal + file|length %}
    {% endfor %}
    <h2 class="text-secondary number-animation mb-0" style="--end:{{ translations|length }}"></h2>
    <a href="{{ path('app_admin_translations_manager') }}" class="stretched-link link-underline-primary link-underline-opacity-0 link-opacity-50-hover fs-4">
        {% trans with {'%count%': translations|length} %}{1}language|]1,Inf]languages{% endtrans %}
    </a>

    {% for local, file in translations %}
        {% set pct = file|length|percentage(fileTotal) %}
        <p class="text-end mb-0"><small class="me-1">{{ local|name }}</small><span class="fst-italic">{% trans with {'%count%': file|length} %}{1}%count% file|]1,Inf]%count% files{% endtrans %}</span></p>
        <p class="progress-percent-bar text-muted" style="--pct:{{ pct }}%; --delay:{{ loop.index * 0.15 }}s"></p>
    {% endfor %}
{% endblock %}

{% block region_client_block %}
    <h2 class="text-secondary number-animation mb-0" style="--end:{{ regionClientPercent|first.percentage|number_format(2, '.', ' ')|round }}"><span></span><small>{{ ux_icon('ic:sharp-percent', {width: '12px', height: '12px'}) }}</small></h2>

    <h5 class="text-light">
        {% trans with {'%name%': regionClientPercent|first.code|department.name|trans([],'regions')} %}Clients in %name%{% endtrans %}
    </h5>

    {% for department in regionClientPercent %}
        {% if not loop.first %}
            <p class="text-end mb-0"><span class="fst-italic fw-bold me-2">{{ department.percentage|number_format(2, '.', ' ') }}%</span><small class="me-1">{{ department.code|department.name|trans([],'regions') }}</small></p>
            <p class="progress-percent-bar text-muted" style="--pct:{{ department.percentage }}%; --delay:{{ loop.index * 0.15 }}s"></p>
        {% endif %}
    {% endfor %}
{% endblock %}

{% block region_pro_block %}
    <h2 class="text-secondary number-animation mb-0" style="--end:{{ regionProPercent|first.percentage|number_format(2, '.', ' ')|round }}"><span></span><small>{{ ux_icon('ic:sharp-percent', {width: '12px', height: '12px'}) }}</small></h2>

    <h5 class="text-light">
        {% trans with {'%name%': regionProPercent|first.code|department.name|trans([],'regions')} %}Professionals in %name%{% endtrans %}
    </h5>

    {% for department in regionProPercent %}
        {% if not loop.first %}
            <p class="text-end mb-0"><span class="fst-italic fw-bold me-2">{{ department.percentage|number_format(2, '.', ' ') }}%</span><small class="me-1">{{ department.code|department.name|trans([],'regions') }}</small></p>
            <p class="progress-percent-bar text-muted" style="--pct:{{ department.percentage }}%; --delay:{{ loop.index * 0.15 }}s"></p>
        {% endif %}
    {% endfor %}
{% endblock %}