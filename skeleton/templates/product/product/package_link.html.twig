{% block package_link %}
    <div class="col position-relative text-center">
        <div class="d-flex justify-content-between">
            {% if package.stock == 0 %}
                <p class="text-danger"><small>{% trans %}Out of stock{% endtrans %}</small></p>
            {% else %}
                <p class="text-info"><small>{% trans with {'%count%': package.stock} %}%count% left{% endtrans %}</small></p>
            {% endif %}
            
            <p class="mb-0 text-end fw-semibold">
                {{ package.name }}<br>
                <small>x{{ package.quantity }}</small>
            </p>
        </div>
        <h4 class="text-center text-muted">
            {{ package.finalPrice|number_format(2, ',', ' ') }}
            {{ ux_icon('ic:round-euro', {width: '14px', height: '14px'}) }}
        </h4>

        <p class="text-center">
            <a class="link-offset-2 link-offset-3-hover link-underline link-underline-opacity-0 link-underline-opacity-75-hover" href="{{ path('app_view_product', {id: package.id}) }}">
                {{ ux_icon('line-md:search') }}
                {% trans %}Package view{% endtrans %}
            </a>
            {% if package.stock > 0 %}
                <a class="btn btn-primary btn-sm ms-3" href="{{ path('app_cart_add', {id: package.id}) }}">
                    {{ ux_icon('ic:round-shopping-cart') }}
                    {% trans %}Add to cart{% endtrans %}
                </a>
            {% endif %}
        </p>
        
    </div>
{% endblock %}