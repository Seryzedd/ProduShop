{% extends 'base.html.twig' %}

{% block title %}
    {% trans with {'%count%': products|length} %}Product|%count% Products{% endtrans %}
{% endblock %}

{% block breadcrumb %}

    {% set breadcrumb = [
        {
            label: 'Shelf "%shelf%" products'|trans({'%shelf%': shelf}),
            route: 'app_shelf_product',
            parameters: {'shelf': shelf}
        },
    ] %}

    {{ parent() }}
{% endblock %}

{% block body %}
    {% set radius = app.request.query.get('radius') ?: 20 %}
    <main class="container">
        <h1 class="mb-2">{% trans with {'%shelf%': shelf} %}"%shelf%" Products{% endtrans %}</h1>
        <div class="row align-items-center">
            <div class="col-lg-11 col-10">
                {{ block("radius_form") }}
            </div>
            <div class="col-lg-1 col-2 text-end">
                <button class="btn btn-primary" title="{% trans %}Show map{% endtrans %}" type="button" data-bs-toggle="collapse" data-bs-target="#collapseMap" aria-expanded="false" aria-controls="collapseMap">
                    {{ ux_icon('line-md:map-marker') }}
                </button>
            </div>
        </div>

        <div id="collapseMap" class="collapse">
            {{ block('map') }}
        </div>

        {% block product_list %}
            <div class="card-group row-cols-1 row-cols-lg-6">
                {% for product in products %}
                    {% include 'product/product/card.html.twig' %}
                {% endfor %}
            </div>
        {% endblock %}
    </main>
{% endblock %}

{% block radius_form %}
    <form methode="GET" class="d-flex align-items-center">
        <div class="col px-2">
            <label for="radius" class="form-label">
                {% trans %}Distance{% endtrans %}
            </label>
            <input type="range" name="radius" value="{{ radius }}" class="form-range" min="5" max="100" step="1" id="radius" unit="km">
            <p class="position-relative"></p>
        </div>
        <button type="submit" class="btn btn-secondary">
            {{ ux_icon('ic:outline-send') }}
        </button>
    </form>
{% endblock %}

{% block map %}
    <div class="">
        {% include 'components/map.html.twig' with {'radius': radius} %}
    </div>
{% endblock %}
