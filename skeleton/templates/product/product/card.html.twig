<div class="card" style="min-width: 290px;">

    {% if product.image.src|length > 0 %}
        <a href="{{ path('app_view_product', {id: product.packages|first.id}) }}" style="overflow: hidden;">
            <img src="{{ product.image.src }}" class="card-img-top" id="main-img-preview" alt="{{ product.image.name }}">
        </a>
    {% else %}
        <div class="d-flex align-items-center bg-light p-4 justify-content-center">
            {{ ux_icon('line-md:image', {width: '30px', height: '30px'}) }}
        </div>
    {% endif %}

    {% if product.slider and product.slider.items|length > 0 %}
        <div class="row no-gutters">
            <div class="col-4 col-lg-3">
                <img class="img-thumbnail img-miniature" src="{{ product.image.src }}">
            </div>
            {% for item in product.slider.items %}
                <div class="col-4 col-lg-3">
                    <img class="img-thumbnail img-miniature" src="{{ item.image.src}}">
                </div>
            {% endfor %}
        </div>
    {% endif %}
    
    <div class="card-body">
        <div class='position-relative text-center'>
            <p class="text-end"><small class="text-muted fst-italic">{{ product.shelf.name }}</small></p>
            <h5 class="card-title">{{ product|translated('name') }}</h5>
            <p class="card-text text-muted">{{ product|translated('description') }}</p>
        </div>
        <p>{% trans %}Solded by{% endtrans %} : <a href="{{ path('app_company', {id: product.company.id}) }}" class="link-offset-2 link-offset-3-hover link-underline link-underline-opacity-0 link-underline-opacity-75-hover">{{ product.company.companyName }}</a></p> 
    </div>

    <div class="card-footer">
        <div class="row no-gutters justify-content-around">
            {% for package in product.packages %}
                <div class="col-lg-4">
                    {% include 'product/product/package_link.html.twig' with {'package': package} %}
                </div>
            {% endfor %}
        </div>
    </div>
</div>

