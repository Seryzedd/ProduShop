{% extends 'base.html.twig' %}

{% block title %}
    {% trans with {'%name%': package.product|translated('name')} %}Product "%name%" view{% endtrans %}
{% endblock %}

{% block breadcrumb %}
    {% set breadcrumb = [
        {
            label: 'Shelf "%shelf%" products',
            route: 'app_shelf_product',
            parameters: {'shelf': package.product.shelf.name},
            translationKey: {'%shelf%': package.product.shelf|translated('name')}
        },
        {
            label: '"%name%" details',
            route: 'app_view_product',
            parameters: {'id': package.id},
            translationKey: {'%name%': package.product|translated('name')}
        }
    ] %}

    {{ parent() }}
{% endblock %}

{% block body %}
    {% set product = package.product %}
    <main class="container">
        <div class="row">
            <div class="col-lg-8">
                {% if product.image.src|length > 0 %}
                    <img class="img-fluid" src="{{ product.image.src }}">
                {% endif %}

                <div class="row">
                    {% if product.slider and product.slider.items|length > 0 %}
                        {% for item in product.slider.items %}
                            <div class="col-4 col-lg-3">
                                <img class="img-thumbnail" src="{{ item.image.src }}">
                            </div>
                        {% endfor %}
                    {% endif %}
                </div>
            </div>
            
            <div class="col-lg-4">
                <h1>{{ product|translated('name') }}</h1>
                <p class="text-muted">{{ product|translated('description') }}</p>
                <div class="border-top"></div>
                <div class="d-flex justify-content-between">
                    <p class="mb-0 {% if package.stock == 0 %}text-danger{% else %}text-info{% endif %}">{% trans with {'%stock%': package.stock} %}%stock% left{% endtrans %}</p>
                    <p class="mb-0 fw-semibold">x{{ package.quantity }}</p>
                </div>
                <h3 class="text-center">
                    {{ package.finalPrice|number_format(2, ',', ' ') }}
                    {{ ux_icon('ic:outline-euro') }}
                </h3>
                <p class="text-center">
                    <a class="btn btn-primary" href="{{ path('app_cart_add', {'id': package.id}) }}">
                        {% trans %}Add to cart{% endtrans %}
                    </a>
                </p>

                {% if product.packages|length > 1 %}
                    <p class="text-end text-primary">{% trans %}Other packages{% endtrans %}</p>
                    
                        {% for otherPack in product.packages %}
                            {% if otherPack !== package %}
                                <div class="row border-top">
                                    {% include 'product/product/package_link.html.twig' with {'package': otherPack} %}
                                </div>
                            {% endif %}
                        {% endfor %}
                {% endif %}
            </div>
        </div>
        <h3 class="text-muted py-4">
            {{ ux_icon('ic:outline-map', {height: '30px', width: '30px'}) }}
            {% trans with {'%merchant%': product.company.companyName} %}Where can I find this %merchant%{% endtrans %}
        </h3>
        {% include 'components/map.html.twig' with {'products': [product]} %}
    </main>
{% endblock %}