{{ form_label(collection) }}

<ul class="{{ collection.vars.name }}-collection list-group list-group{% if sortable is defined and sortable is true %} sortable-list{% endif %}"
    {% if collection.vars.prototype is defined %}
        data-prototype="{{ form_widget(collection.vars.prototype)|e('html_attr') }}"
    {% endif %}
    deletable="{{ collection.vars.allow_delete }}"
    data-index="{{ collection|length > 0 ? collection|length + 1 : 0 }}"
    {% if formInline is defined %}
        data-inline-items="{{ formInline ? 'true' : 'false' }}"
    {% endif %}
>
    {% for item in collection %}
        {% if item.vars.name != '_token' %}
            <li class="list-group-item{% if sortable is defined and sortable is true %} sortable-item{% endif %}">
                <p class="text-end top-0 end-0 position-absolute">
                    {% if sortable is defined and sortable is true %}
                        <button type="button" class="drag-handle btn btn-ouline-dark">
                            {{ ux_icon('ic:twotone-drag-handle')}}
                        </button>
                    {% endif %}
                    {% if collection.vars.prototype is defined %}
                        <button type="button" class="btn btn-ouline-danger remove_collection_item_btn btn-trash"></button>
                    {% endif %}
                </p>
                
                {{ form_row(item) }}
            </li>
        {% endif %}
    {% endfor %}
</ul>

{% if collection.vars.allow_add %}
    <p class="text-end">
        <button type="button" class="add_collection_item_btn btn btn-outline-secondary btn-sm" data-collection-holder-class="{{ collection.vars.name }}-collection">
            {% if buttonText is defined %}
                {% if buttonText != false %}
                    {{ buttonText }}
                {% endif %}
            {% else %}
                {% trans %}Add new{% endtrans %}
            {% endif %}
            
            {{ ux_icon('ic:outline-add', {height: '20px', width: '20px'}) }}
        </button>
    </p>
{% endif %}

{% do collection.setRendered %}