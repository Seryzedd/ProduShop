<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Welcome!{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        {% block stylesheets %}
            {{ importmap('app.scss') }}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body>
        {% block header %}
            {% include 'components/header.html.twig' %}
        {% endblock %}

        {% block breadcrumb %}
            {% include 'components/breadcrumb.html.twig' %}
        {% endblock %}

        {% block cart_content %}
            {% include 'components/cart/canvas.html.twig' %}
        {% endblock %}

        {% block flash_messages %}
            {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ label }} row">
                    <div class="col-md-2">
                        {% if label == 'danger' %}
                            {{ ux_icon('ic:outline-report-problem') }}
                        {% elseif label == 'success' %}
                            {{ ux_icon('ic:outline-done-outline') }}
                        {% elseif label == 'warning' %}
                            {{ ux_icon('ic:outline-warning') }}
                        {% elseif label == 'info' %}
                            {{ ux_icon('ic:outline-tips-and-updates') }}
                        {% endif %}
                    </div>

                    <p class="col-md-10 mb-0">
                        {{ message }}
                    </p>
                </div>
            {% endfor %}
        {% endfor %}

        {% endblock %}

        {% block body %}{% endblock %}
    </body>
</html>
