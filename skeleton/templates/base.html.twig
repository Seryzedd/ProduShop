<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Welcome!{% endblock %}</title>
        <link rel="icon" href="{{ asset('icons/favicon.png') }}" />
        {% block stylesheets %}
            {{ importmap('app.scss') }}
        {% endblock %}
    </head>
    <body>
        {% block header %}
            {% include 'components/header.html.twig' %}
        {% endblock %}

        {% block admin_menu %}
            {% include 'components/admin_menu.html.twig' %}
        {% endblock %}

        {% block breadcrumb %}
            {% include 'components/breadcrumb.html.twig' %}
        {% endblock %}

        {% block cart_content %}
            {% include 'components/cart/canvas.html.twig' %}
        {% endblock %}

        {% block flash_messages %}
            <div id="flash-messages" class="container">
                {% for label, messages in app.session.flashbag.all() %}
                    {% for message in messages %}
                        <div class="alert alert-{{ label }} row align-items-center">
                            <div class="col-md-1">
                                {% set size = {width: '30px', height: '30px'} %}
                                {% if label == 'danger' %}
                                    {{ ux_icon('ic:outline-report-problem', size) }}
                                {% elseif label == 'success' %}
                                    {{ ux_icon('ic:outline-done-outline', size) }}
                                {% elseif label == 'warning' %}
                                    {{ ux_icon('ic:outline-warning', size) }}
                                {% elseif label == 'info' %}
                                    {{ ux_icon('ic:outline-tips-and-updates', size) }}
                                {% endif %}
                            </div>

                            <p class="col-md-10 mb-0 px-4">
                                {{ message|trans }}
                            </p>

                            <p class="mb-0 col-md-1 text-end">
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                            </p>
                        </div>
                    {% endfor %}
                {% endfor %}
            </div>
        {% endblock %}

        {% block body %}{% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </body>
</html>
