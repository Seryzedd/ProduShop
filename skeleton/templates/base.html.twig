<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Welcome!{% endblock %}</title>
        <link rel="icon" href="{{ asset('icons/favicon.png') }}" />
        {% block stylesheets %}
            {{ importmap('app.scss') }}
        {% endblock %}
    </head>
    <body>
        {% block header %}
            {% include 'components/header.html.twig' %}
        {% endblock %}

        {% block admin_menu %}
            {% if is_granted('ROLE_ADMIN') %}
                <nav class="position-sticky top-0 bg-body-tertiary justify-content-start d-flex">
                    <ul class="navbar-nav container flex-row">
                        <li class="nav-item">
                            <button class="nav-link text-dark px-2" type="button" data-bs-toggle="offcanvas" data-bs-target="#adminMenu" aria-controls="adminMenu">
                                {% trans %}Admin menu{% endtrans %}
                                {{ ux_icon('line-md:arrow-right') }}
                            </button>
                        </li>
                    </ul>
                </nav>

                <div class="offcanvas offcanvas-start" data-bs-backdrop="static" tabindex="-1" id="adminMenu" style="width: fit-content;" aria-labelledby="staticBackdropLabel">
                    <div class="offcanvas-header">
                        <h5 class="offcanvas-title" id="staticBackdropLabel">
                            {% trans %}Admin menu{% endtrans %}
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
                    </div>
                    <div class="offcanvas-body">
                        <ul class="nav flex-column">
                            <li class="nav-item">
                                <a class="nav-link" aria-current="page" href="{{ path('app_admin_index') }}">
                                    {{ ux_icon('line-md:home-alt-twotone') }}
                                    {% trans %}Admin Homepage{% endtrans %}
                                </a>
                            </li>
                            <li class="nav-item">
                                
                                <button class="nav-link" type="button" data-bs-toggle="collapse" data-bs-target="#lang_sub" aria-expanded="false" aria-controls="lang_sub">
                                    {{ ux_icon('mdi:google-translate' )}}
                                    {% trans %}Languages{% endtrans %}
                                </button>
                                <div class="collapse" id="lang_sub">
                                    <ul class="nav flex-column ps-3">
                                        <li class="nav-item">
                                            <a class="nav-link" href="{{ path('app_admin_translations_manager') }}">
                                                {% trans %}Manager{% endtrans %}
                                            </a>
                                        </li>
                                        <li class="nav-item">
                                            <a class="nav-link" href="{{ path('app_admin_translations_files') }}">
                                                {% trans %}Files{% endtrans %}
                                            </a>
                                        </li>
                                    </ul>
                                </div>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="{{ path('app_admin_product_shelf') }}">
                                    {{ ux_icon('mdi:store') }}
                                    {% trans %}Products{% endtrans %}
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
                
            {% endif %}
        {% endblock %}

        {% block breadcrumb %}
            {% include 'components/breadcrumb.html.twig' %}
        {% endblock %}

        {% block cart_content %}
            {% include 'components/cart/canvas.html.twig' %}
        {% endblock %}

        {% block flash_messages %}
            <div id="flash-messages" class="container">
                {% for label, messages in app.session.flashbag.all() %}
                    {% for message in messages %}
                        <div class="alert alert-{{ label }} row align-items-center">
                            <div class="col-md-1">
                                {% set size = {width: '30px', height: '30px'} %}
                                {% if label == 'danger' %}
                                    {{ ux_icon('ic:outline-report-problem', size) }}
                                {% elseif label == 'success' %}
                                    {{ ux_icon('ic:outline-done-outline', size) }}
                                {% elseif label == 'warning' %}
                                    {{ ux_icon('ic:outline-warning', size) }}
                                {% elseif label == 'info' %}
                                    {{ ux_icon('ic:outline-tips-and-updates', size) }}
                                {% endif %}
                            </div>

                            <p class="col-md-10 mb-0 px-4">
                                {{ message|trans }}
                            </p>

                            <p class="mb-0 col-md-1 text-end">
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                            </p>
                        </div>
                    {% endfor %}
                {% endfor %}
            </div>
        {% endblock %}

        {% block body %}{% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </body>
</html>
