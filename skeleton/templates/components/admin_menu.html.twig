{% if is_granted('ROLE_ADMIN') %}

    <div class="h-100 border-end" id="adminMenu" style="width: fit-content;">
        <div class="text-end p-2">
            <input type="checkbox" id="admin-btn" request-url="{{ path('admin_menu') }}" {% if session('admin-menu-expanded') %}checked{% endif %}>
            <label for="admin-btn" class="btn-more-less"></label>
        </div>
        <div class="offcanvas-body">
            <ul class="nav flex-column">
                <li class="nav-item">
                    <a class="nav-link text-start {% if app.request.attributes.get('_route') == 'app_admin_index' %} active disabled{% endif %}" aria-current="page" href="{{ path('app_admin_index') }}">
                        {{ ux_icon('line-md:home-alt-twotone') }}
                        <span>{% trans %}Admin Homepage{% endtrans %}</span>
                    </a>
                </li>
                <li class="nav-item">
                    <button class="nav-link text-start" type="button" data-bs-toggle="collapse" data-bs-target="#lang_sub" aria-expanded="false" aria-controls="lang_sub">
                        {{ ux_icon('mdi:google-translate' )}}
                        <span>{% trans %}Languages{% endtrans %}</span>
                    </button>
                    <div class="collapse" id="lang_sub">
                        <ul class="nav flex-column ps-3">
                            <li class="nav-item">
                                <a class="nav-link text-start{% if app.request.attributes.get('_route') == 'app_admin_translations_manager' %} active disabled{% endif %}" href="{{ path('app_admin_translations_manager') }}">
                                    <span>{% trans %}Manager{% endtrans %}</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-start{% if app.request.attributes.get('_route') == 'app_admin_translations_files' %} active disabled{% endif %}" href="{{ path('app_admin_translations_files') }}">
                                    <span>{% trans %}Files{% endtrans %}</span>
                                </a>
                            </li>
                        </ul>
                    </div>
                </li>
                <li class="nav-item">
                    <a class="nav-link {% if app.request.attributes.get('_route') == 'app_admin_product_shelf' %} active disabled{% endif %}" href="{{ path('app_admin_product_shelf') }}">
                        {{ ux_icon('mdi:store') }}
                        <span>{% trans %}Products{% endtrans %}</span>
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link {% if app.request.attributes.get('_route') == 'app_admin_users' %} active disabled{% endif %}" href="{{ path('app_admin_users') }}">
                        {{ ux_icon('ic:baseline-group') }}
                        <span>{% trans %}Users{% endtrans %}</span>
                    </a>
                </li>
            </ul>
        </div>
    </div>
{% endif %}