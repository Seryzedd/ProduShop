<nav class="navbar navbar-expand-lg bg-body-tertiary sticky-top" id="main-header">
    <div class="container-fluid container">
        <a class="navbar-brand logo p-2" href="{{ path('app_home_index') }}">
            <img src="{{ asset('icons/logo.png') }}" alt="Logo" class="img-fluid">
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarText" aria-controls="navbarText" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarText">
            <div class="mx-auto">
                <form class="d-inline-flex align-items-center">
                    <input type="text" class="form-control" placeholder="{% trans %}Search{% endtrans %}..." async-url="{{ path('app_async') }}" name="search" id="async-search">
                    <label class="p-2 text-muted" for="floatingInputValue">{{ ux_icon('line-md:search') }}</label>
                </form>


                <ul class="navbar-nav me-auto mb-2 mt-2 mb-lg-0">
                    {% if is_granted('ROLE_ADMIN') %}
                        <li class="nav-item">
                            <button class="nav-link text-dark px-2" type="button" data-bs-toggle="offcanvas" data-bs-target="#adminMenu" aria-controls="adminMenu">
                                {{ ux_icon('ic:twotone-admin-panel-settings', {width: '24px', height: '24px'}) }}
                            </button>
                        </li>
                    {% endif %}

                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_companies') }}" title="{% trans %}Companies{% endtrans %}">
                            {% trans %}Companies{% endtrans %}
                        </a>
                    </li>

                    {% if shelvesEntities|length > 0 %}
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                {% trans %}Shelves products{% endtrans %}
                            </a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" href="{{ path('app_shelf_product') }}">{% trans %}All{% endtrans %}</a></li>
                                {% for shelf in shelvesEntities %}
                                    <li><a class="dropdown-item" href="{{ path('app_shelf_product', {'shelf': shelf.name}) }}">{{ shelf.name }}</a></li>
                                {% endfor %}
                            </ul>
                        </li>
                    {% endif %}
                </ul>
            </div>
            
            
            <ul class="navbar-nav mb-2 mb-lg-0">
                <li class="nav-item">
                    {% if app.enabled_locales|length <= 1 %}
                        <button class="nav-link disabled" type="button">
                            {{ app.locale|language }}
                            <small>{{ app.locale|region }}</small>
                        </button>
                    {% else %}
                        <div class="btn-group">
                            <button type="button" class="nav-link dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                                {{ app.locale|language }}
                                <small class="fw-lighter">{{ app.locale|region }}</small>
                            </button>
                            
                            <form method="post" action="{{ app.request.uri }}" name="locale-switcher" class="dropdown-menu">
                                {% for locale in app.enabled_locales %}
                                    {% if locale != app.locale %}
                                        <button type="submit" class="dropdown-item" value="{{ locale }}" name="locale_language">
                                            {{ locale|language }}
                                                
                                            {% if locale|region != '' %}
                                                <small class="fw-lighter">{{ locale|region }}</small>
                                            {% endif %}
                                        </button>
                                    {% endif %}
                                {% endfor %}
                            </form>
                        </div>
                    {% endif %}
                </li>

                {% if is_granted('IS_AUTHENTICATED_FULLY') %}
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            {{ ux_icon('ic:twotone-account-circle', {height: '20px', width: '20px'}) }}
                        </a>
                        <ul class="dropdown-menu dropdown-menu-lg-end">
                            <li>
                                <a class="dropdown-item" href="{{ path('app_account_informations') }}" title="{% trans %}My account{% endtrans %}">
                                    {{ ux_icon('ic:outline-person', {height: '20px', width: '20px'}) }}
                                    {% trans %}My account{% endtrans %}
                                </a>
                            </li>

                            {% if is_granted('ROLE_SELLER') %}
                                <li>
                                    <a class="dropdown-item" href="{{ path('app_merchant_products') }}" title="{% trans %}My products{% endtrans %}">
                                        {{ ux_icon('ic:outline-inventory-2', {height: '20px', width: '20px'}) }}
                                        {% trans %}My products{% endtrans %}
                                    </a>
                                </li>
                            {% endif %}

                            {% if is_granted('ROLE_ADMIN') %}
                                <li>
                                    <a class="dropdown-item text-secondary" href="{{ path('app_admin_index') }}" title="{% trans %}Admin dashboard{% endtrans %}">
                                        {{ ux_icon('ic:outline-dashboard', {height: '20px', width: '20px'}) }}
                                        {% trans %}Admin dashboard{% endtrans %}
                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item" href="{{ path('app_admin_translations_manager') }}" title="{% trans %}Translations manager{% endtrans %}">
                                        {{ ux_icon('ic:outline-g-translate', {height: '20px', width: '20px'}) }}
                                        {% trans %}Translations manager{% endtrans %}
                                    </a>
                                </li>
                            {% endif %}

                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <a class="dropdown-item text-danger" href="{{ path('app_logout') }}" title="{% trans %}Logout{% endtrans %}">
                                    {{ ux_icon('ic:twotone-logout', {height: '20px', width: '20px'}) }}
                                    {% trans %}Logout{% endtrans %}
                                </a>
                            </li>
                        </ul>
                    </li>

                    {% if is_granted('ROLE_USER') %}
                        <li class="nav-item">
                            <button class="nav-link position-relative" type="button" title="{% trans %}My cart{% endtrans %}" data-bs-toggle="offcanvas" data-bs-target="#offcanvasRight" aria-controls="offcanvasRight">
                                {{ ux_icon('ic:twotone-shopping-basket', {height: '24px', width: '24px'}) }}
                                {% if not cart.empty %}
                                    <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-secondary">
                                        {{ cart.itemCount }}
                                    </span>
                                {% endif %}
                            </button>
                        </li>
                    {% endif %}
                {% else %}
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_login') }}" title="{% trans %}Connexion{% endtrans %}">
                            {{ ux_icon('ic:outline-login', {height: '24px', width: '24px'}) }}
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_register') }}" title="{% trans %}Create account{% endtrans %}">
                            {{ ux_icon('ic:outline-person-outline', {height: '24px', width: '24px'}) }}
                        </a>
                    </li>
                {% endif %}
            </ul>
        </div>
    </div>
</nav>