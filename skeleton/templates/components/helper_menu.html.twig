<div class="accordion accordion-flush" id="accordionCategoriesMenu">
    {% if categories|length > 0 %}
        <p class="mb-0"><small>{% trans %}How to{% endtrans %} :</small></p>
        {% for category in categories %}
            {% if category.hasActiveDocumentation %}
                <div class="">
                    <p class="accordion-header">
                        <button class="accordion-button py-1 bg-transparent collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#flush-collapse_{{ category.id }}" aria-expanded="false" aria-controls="flush-collapse_{{ category.id }}">
                            {{ category.name }}
                        </button>
                    </p>
                    <div id="flush-collapse_{{ category.id }}" class="accordion-collapse collapse" data-bs-parent="#accordionCategoriesMenu">
                        <div class="accordion-body py-1">
                            <nav class="nav flex-column">
                                {% for documentation in category.documentations %}
                                    <a class="link-body-emphasis link-underline-opacity-0 link-underline-opacity-75-hover py-1" aria-current="page" href="{{ path('app_helper', {documentation: documentation.id}) }}">{{ documentation.name }}</a>
                                {% endfor %}
                            </nav>
                        </div>
                    </div>
                </div>
            {% endif %}
        {% endfor %}
    {% endif %}
    
</div>