<div class="accordion accordion-flush" id="accordionCategoriesMenu">
    {% if categories|length > 0 %}
        {% for category in categories %}
            {% if category.hasActiveDocumentation %}
                <div class="accordion-item">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#flush-collapseOne" aria-expanded="false" aria-controls="flush-collapseOne">
                            {{ category.name }}
                        </button>
                    </h2>
                    <div id="flush-collapse_{{ category.id }}" class="accordion-collapse collapse" data-bs-parent="#accordionCategoriesMenu">
                        <div class="accordion-body">
                            <nav class="nav flex-column">
                                {% for documentation in category.documentations %}
                                    <a class="nav-link" aria-current="page" href="#">Active</a>
                                {% endfor %}
                            </nav>
                        </div>
                    </div>
                </div>
            {% endif %}
        {% endfor %}
    {% endif %}
    
</div>