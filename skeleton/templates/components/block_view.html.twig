<div class="position-relative" style="background-color: {{ block.backgroundColor }};">
    {% if block.backgroundImage != null and block.backgroundImage.src|length > 0 %}
        <img src="{{ block.backgroundImage.src }}" style="object-fit: cover; width: 100%; height: 100%" class="z-1">
        <div class="position-absolute z-2 p-2">
            {% for element in block.htmlElement %}
                {{ element.html|raw }}
            {% endfor %}
        </div>
    {% else %}
        <div class="p-2">
            {% for element in block.htmlElement %}
                {{ element.html|raw }}
            {% endfor %}
        </div>
    {% endif %}
</div>