<div class="position-relative" style="color: {{ block.textColor }}; background-color: {{ block.backgroundColor }};">
    {% if block.backgroundImage != null and block.backgroundImage.src|length > 0 %}
        <img src="{{ block.backgroundImage.src }}" style="object-fit: cover; width: 100%; height: 100%" class="">
        <p class='position-absolute mb-0 top-0 p-2'>{{ block.text }}</p>
    {% else %}
        <p class="p-2 mb-0">{{ block.text }}</p>
    {% endif %}
</div>