{# templates/client/_map.html.twig
   ──────────────────────────────────────────────────────────────
   Composant carte — Leaflet.js + OpenStreetMap (100% gratuit)
   Les coordonnées sont lues depuis la base de données (lat/lng
   stockés sur Adress), aucun appel API au chargement de la page.
   ────────────────────────────────────────────────────────────── #}

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">

<style>
    #map { width: 100%; height: 100%; min-height: 400px; z-index: 0; }
    .map-sidebar-list { overflow-y: auto; max-height: 100%; }

    @keyframes pulse {
        0%   { box-shadow: 0 0 0 0 rgba(13,110,253,.5); }
        70%  { box-shadow: 0 0 0 12px rgba(13,110,253,0); }
        100% { box-shadow: 0 0 0 0 rgba(13,110,253,0); }
    }
    .user-marker-dot {
        width: 16px; height: 16px;
        background: #0d6efd;
        border: 3px solid #fff;
        border-radius: 50%;
        animation: pulse 2s infinite;
        box-shadow: 0 2px 6px rgba(0,0,0,.3);
    }

    /* Offcanvas slide-in when .show is toggled */
    #routeOffcanvas.show { transform: translateX(0) !important; }

    /* Hide LRM's default floating panel entirely */
    .leaflet-routing-container { display: none !important; }

    /* Custom itinerary offcanvas content */
    #routeStepsList {
        font-size: 0.82rem;
    }
    #routeStepsList li {
        padding: 0.4rem 0;
        border-bottom: 1px solid #f0f0f0;
        display: flex;
        gap: 0.5rem;
        align-items: flex-start;
    }
    #routeStepsList li:last-child { border-bottom: none; }
    #routeStepsList .step-icon { flex-shrink: 0; color: #0d6efd; margin-top: 2px; }
    #routeSummary { font-size: 0.82rem; }
</style>

{% if adress is not defined %}
    {% set adress = null %}
{% endif %}

{% if app.user %}
    <div class="row align-items-center">
        <div class="col-md-8">
            {{ block('radius_form', 'product/product/index.html.twig') }}
        </div>

        <div class="col-md-4 my-2">
                
                {% if app.user|instanceOf('App\\Entity\\User\\Client') %}
                    <div class="dropdown" id="adress-dropdown">
                        <button class="btn btn-outline-dark dropdown-toggle w-100" id="adressDropdownLabel" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            {% if adress %}
                                {{ adress.street }} {{ adress.zipCode }} {{ adress.country }}
                            {% else %}
                                {{ 'Select an address'|trans }}
                            {% endif %}
                        </button>
                        <ul class="dropdown-menu">
                            <li>
                                <a class="dropdown-item d-flex align-items-center gap-2"
                                    href="#"
                                    data-value="__geoloc__"
                                >
                                    {{ ux_icon('ic:baseline-share-location') }}
                                    {{ 'My current position'|trans }}
                                </a>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            {% for shippingAdress in app.user.shippingAdress %}
                                <li>
                                    <a class="dropdown-item d-flex align-items-center gap-2 {% if adress == shippingAdress %}active{% endif %}"
                                    href="#"
                                    data-value="{{ shippingAdress.id }}"
                                    data-radius="{{ radius }}"
                                    data-url="{{ path('map_products_adress_list', { adress: shippingAdress.id, 'radius': radius }) }}">
                                        {{ ux_icon('ic:outline-location-city') }}
                                        {{ shippingAdress.street }} {{ shippingAdress.zipCode }} {{ shippingAdress.country }}
                                    </a>
                                </li>
                            {% endfor %}
                        </ul>
                    </div>
                    
                {% elseif app.user|instanceOf('App\\Entity\\User\\Professional') %}
                    {% set adress = app.user.adress %}
                    <p class="me-2">
                        {% trans %}My adress{% endtrans %} :
                    </p>
                    <p class="text-muted">
                        {{ adress.street }}<br>
                        {{ adress.zipCode }} {{ adress.country }}
                    </p>
                {% endif %}
            </div>
    </div>
    
{% endif %}

<div class="d-flex border rounded overflow-hidden" style="max-height: 520px;">
    {% set companies = [] %}
    {% if list is not defined %}
        {% set list = true %}
    {% endif %}

    {% if radius is not defined %}
        {% set radius = 20 %}
    {% endif %}

    {# ── Sidebar ── #}
    {% if list == true %}
        <div class="d-flex flex-column border-end bg-white" style="width: 50%; flex-shrink: 0;">

            <div class="p-2 border-bottom">

                <input type="search" id="mapSearchInput" class="form-control form-control-sm"
                    placeholder="Rechercher…">
            </div>
            {% if adress == null and app.user and app.user.shippingAdress|length > 0 %}
                {% set adress = app.user.shippingAdress|first %}
            {% endif %}

            <div class="map-sidebar-list flex-grow-1">
                {% if products is empty %}
                    <p class="text-muted text-center small py-4">
                        {% trans %}No product available{% endtrans %}
                    </p>
                {% else %}
                    {% for product in products %}
                        {% if product.company not in companies %}
                            {% set companies = companies|merge([product.company]) %}
                            <a href="{{ path('app_company', {id: product.company.id}) }}" class="link-offset-2 fw-bold px-2 ms-2 mt-3 link-offset-3-hover link-secondary link-underline link-underline-opacity-0 link-underline-opacity-75-hover">
                                {{ product.company.companyName }}
                            </a>
                            <div class="p-2 border-bottom map-product-card position-relative"
                                role="button"
                                data-index="{{ loop.index0 }}"
                                data-name="{{ product.name|lower }}"
                                data-company="{{ product.company.companyName|lower }}"
                                onclick="mapFocusMarker({{ loop.index0 }})"
                                onmouseover="this.classList.add('bg-light')"
                                onmouseout="this.classList.remove('bg-light')"
                                style="cursor:pointer;"
                            >
                                {% if product.company.adress is defined and product.company.adress %}
                                    <p class="mb-0 text-muted" style="font-size:.68rem;">
                                        {{ ux_icon('ic:baseline-share-location') }}

                                        {{ product.company.adress.street }}
                                        {{ product.company.adress.zipCode }} {{ product.company.adress.country }}
                                    </p>
                                {% endif %}

                                <span class="position-absolute top-0 end-0 badge rounded-pill{% if product.company.open %} bg-success{% else %} bg-danger{% endif %}">{{ product.company.open ? 'Opened'|trans : 'Closed'|trans }}</span>
                            </div>
                        {% endif %}
                    {% endfor %}
                {% endif %}
            </div>
        </div>
    {% else %}
        {% for product in products %}
            {% if product.company not in companies %}
                {% set companies = companies|merge([product.company]) %}
            {% endif %}
        {% endfor %}
    {% endif %}

    {# ── Carte ── #}
    <div class="flex-grow-1 position-relative">
        <div id="map"></div>

        {# ── Itinerary toggle button (visible only when a route is active) ── #}
        <button id="routeToggleBtn"
                class="btn btn-primary btn-sm position-absolute d-none"
                style="bottom: 1rem; right: 1rem; z-index: 999;"
                onclick="document.getElementById('routeOffcanvas').classList.toggle('show')">
            <i class="bi bi-signpost-2-fill me-1"></i>{% trans %}Itinerary{% endtrans %}
        </button>
    </div>
</div>


{# ── Itinerary offcanvas panel (Bootstrap, no JS plugin needed) ── #}
<div id="routeOffcanvas"
     class="position-fixed top-0 end-0 h-100 bg-white shadow-lg"
     style="width: 320px; z-index: 1050; transform: translateX(100%);
            transition: transform 0.3s ease; overflow-y: auto;">
    <div class="d-flex align-items-center justify-content-between p-3 border-bottom">
        <h6 class="mb-0 fw-semibold">
            <svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#1f1f1f"><path d="M440-80v-200q0-56-17-83t-45-53l57-57q12 11 23 23.5t22 26.5q14-19 28.5-33.5T538-485q38-35 69-81t33-161l-63 63-57-56 160-160 160 160-56 56-64-63q-2 143-44 203.5T592-425q-32 29-52 56.5T520-280v200h-80ZM248-633q-4-20-5.5-44t-2.5-50l-64 63-56-56 160-160 160 160-57 56-63-62q0 21 2 39.5t4 34.5l-78 19Zm86 176q-20-21-38.5-49T263-575l77-19q10 27 23 46t28 34l-57 57Z"/></svg>
            {% trans %}Itinerary{% endtrans %}
        </h6>
        <button class="btn-close"
                onclick="document.getElementById('routeOffcanvas').classList.remove('show')">
        </button>
    </div>

    <div class="p-3 border-bottom bg-light" id="routeSummary">
        <span class="text-muted">{% trans %}Calculating{% endtrans %}...</span>
    </div>

    <ul class="list-unstyled p-3 mb-0" id="routeStepsList"></ul>
</div>

{# ── Données JSON injectées depuis PHP (coordonnées déjà en base) ── #}
<script>
    window._mapData = {
        radiusKm: {{ radius is defined and radius is not null ? radius|json_encode|raw : 'null' }},
        // Active locale — used by Leaflet Routing Machine to translate step instructions
        locale:   {{ app.request.locale|slice(0, 2)|json_encode|raw }},
        client: {
            {% if adress and adress.hasCoordinates() %}
                lat: {{ adress.latitude }},
                lng: {{ adress.longitude }}
            {% else %}
                lat: null,
                lng: null
            {% endif %}
        },
        products: [
            {% for company in companies %}
                {% set addr = company.adress %}
                {% if addr and addr.hasCoordinates() %}
                    {
                        company: {{ (company.companyName ?? '')|json_encode|raw }},
                        companyLink: {{ path('app_company', { id: company.id })|json_encode|raw }},
                        lat:     {{ addr.latitude }},
                        lng:     {{ addr.longitude }},
                        phone: {{ company.phone|json_encode|raw }},
                        address: {{ (addr.street ~ ', ' ~ addr.zipCode ~ ' ' ~ addr.country)|json_encode|raw }}
                    }
                    {% if not loop.last %},{% endif %}
                {% endif %}
            {% endfor %}
        ]
    };
</script>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script src="https://unpkg.com/leaflet-routing-machine@3.2.12/dist/leaflet-routing-machine.js"></script>
<script>
    (function () {
        const data    = window._mapData;
        const markers = [];

        // ── Product icon (inline SVG) ─────────────────────────────
        const productIcon = L.divIcon({
            className: '',
            html: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="36" viewBox="0 0 28 36">
                    <path d="M14 0C6.27 0 0 6.27 0 14c0 9.625 14 22 14 22S28 23.625 28 14C28 6.27 21.73 0 14 0z"
                        fill="#212529" stroke="#0d6efd" stroke-width="2"/>
                    <circle cx="14" cy="14" r="5" fill="#0d6efd"/>
                </svg>`,
            iconSize:   [28, 36],
            iconAnchor: [14, 36],
            popupAnchor:[0, -38],
        });

        // ── Client icon (pulsing dot) ─────────────────────────────
        const clientIcon = L.divIcon({
            className: '',
            html: `<div class="user-marker-dot"></div>`,
            iconSize:   [16, 16],
            iconAnchor: [8, 8],
            popupAnchor:[0, -12],
        });

        // ── Map initialisation — synchronous, no network call ────────
        // `let` (pas `const`) : ces valeurs sont réassignées après chaque
        // mise à jour asynchrone (changement d'adresse / géolocalisation).
        let clientLatLng   = data.client.lat !== null ? [data.client.lat, data.client.lng] : null;
        let routingControl = null; // holds the active route, replaced on each click
        let clientMarker   = null;
        let radiusCircle   = null;

        const map = L.map('map').setView(
            clientLatLng ?? [46.603354, 1.888334],
            clientLatLng ? 12 : 6
        );

        L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
            maxZoom:     19,
            attribution: '© <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
        }).addTo(map);

        // ── Popup content ─────────────────────────────────────────
        function buildPopup(p) {
            return `
                <div style="min-width:180px;font-family:var(--bs-body-font-family,sans-serif)">
                    <a href="${p.companyLink}" class="link-offset-2 link-offset-3-hover link-underline link-underline-opacity-0 link-underline-opacity-75-hover fw-semibold">${esc(p.company)}</a>
                    <p class="mb-0">${p.phone}</p>
                    <hr class="my-2">
                    <p class="mb-0 text-muted small">
                        <i class="bi bi-geo-alt-fill text-primary"></i> ${esc(p.address)}
                    </p>
                </div>`;
        }

        // ── Client marker + radius circle ─────────────────────────
        function renderClient(latlng, radiusKm) {
            if (clientMarker) { map.removeLayer(clientMarker); clientMarker = null; }
            if (radiusCircle) { map.removeLayer(radiusCircle); radiusCircle = null; }

            if (!latlng) return;

            clientMarker = L.marker(latlng, { icon: clientIcon })
                .addTo(map)
                .bindPopup('<strong>' + "{{ 'Calculating'|trans }}" + '...</strong>');

            if (radiusKm !== null && radiusKm !== undefined) {
                radiusCircle = L.circle(latlng, {
                    radius:      radiusKm * 1000,
                    color:       '#a3c8ff',
                    fillColor:   '#84b5ff',
                    fillOpacity: 0.05,
                    weight:      2,
                }).addTo(map);

                // Auto-zoom: fit the map to the circle's bounding box
                map.fitBounds(radiusCircle.getBounds(), { padding: [20, 20] });
            } else {
                map.setView(latlng, 13, { animate: true });
            }
        }

        // ── Product markers ───────────────────────────────────────
        function renderProducts(products) {
            markers.forEach(m => map.removeLayer(m));
            markers.length = 0;

            products.forEach((p, i) => {
                const marker = L.marker([p.lat, p.lng], { icon: productIcon })
                    .addTo(map)
                    .bindPopup(buildPopup(p));

                marker.on('click', () => {
                    setActive(i);
                    drawRoute(marker.getLatLng());
                });
                markers.push(marker);
            });

            if (clientLatLng && markers.length === 1) {
                drawRoute(markers[0].getLatLng());
            }
        }

        // ── Initial (synchronous) render ────────────────────────────
        renderClient(clientLatLng, data.radiusKm);
        renderProducts(data.products);

        // ── Focus from sidebar → map + draw route ────────────────
        window.mapFocusMarker = function (index) {
            const marker = markers[index];
            if (!marker) return;
            map.setView(marker.getLatLng(), 14, { animate: true });
            marker.openPopup();
            setActive(index);
            drawRoute(marker.getLatLng());
        };

        // ── Routing via OSRM (free, no API key) ───────────────────
        function drawRoute(destination) {
            if (!clientLatLng) return;

            // Remove the previous route if any
            if (routingControl) {
                map.removeControl(routingControl);
                routingControl = null;
            }

            // Reset the custom panel to loading state
            document.getElementById('routeSummary').innerHTML =
                '<span class="text-muted">' + "{{ 'Calculating'|trans }}" + '...</span>';
            document.getElementById('routeStepsList').innerHTML = '';

            routingControl = L.Routing.control({
                waypoints: [
                    L.latLng(clientLatLng[0], clientLatLng[1]),
                    destination,
                ],
                language:           data.locale,  // translate steps to the active locale
                routeWhileDragging: false,
                addWaypoints:       false,
                draggableWaypoints: false,
                fitSelectedRoutes:  true,
                show:               false,   // always hide the default LRM panel
                lineOptions: {
                    styles: [{ color: '#0d6efd', weight: 4, opacity: 0.8 }],
                    extendToWaypoints:     true,
                    missingRouteTolerance: 0,
                },
                createMarker: () => null,
            }).addTo(map);

            // When the route is computed, populate our custom panel
            routingControl.on('routesfound', function (e) {
                const route    = e.routes[0];
                const totalKm  = (route.summary.totalDistance / 1000).toFixed(1);
                const totalMin = Math.round(route.summary.totalTime / 60);
                const hours    = Math.floor(totalMin / 60);
                const mins     = totalMin % 60;
                const duration = hours > 0 ? `${hours}h ${mins}min` : `${mins} min`;

                // Summary bar
                document.getElementById('routeSummary').innerHTML = `
                    <div class="d-flex gap-3">
                        <span><i class="bi bi-sign-turn-right-fill text-primary me-1"></i>
                            <strong>${totalKm} km</strong>
                        </span>
                        <span><i class="bi bi-clock-fill text-primary me-1"></i>
                            <strong>${duration}</strong>
                        </span>
                    </div>`;

                // Step-by-step list
                const ul = document.getElementById('routeStepsList');
                ul.innerHTML = '';
                route.instructions.forEach(step => {
                    const li = document.createElement('li');
                    li.innerHTML = `
                        <i class="bi bi-arrow-right-circle step-icon"></i>
                        <span>${esc(step.text)}
                            ${step.distance > 0
                                ? `<span class="text-muted ms-1">(${(step.distance).toFixed(0)} m)</span>`
                                : ''}
                        </span>`;
                    ul.appendChild(li);
                });

                // Show the toggle button and open the panel automatically
                document.getElementById('routeToggleBtn').classList.remove('d-none');
                document.getElementById('routeOffcanvas').classList.add('show');

                const start = L.latLng(clientLatLng[0], clientLatLng[1]);
                if (start.distanceTo(destination) < 50) {
                    map.setView(clientLatLng, 15);
                    document.getElementById('routeOffcanvas').classList.remove('show');
                    document.getElementById('routeToggleBtn').classList.add('d-none');
                }
            });
        }

        function setActive(index) {
            document.querySelectorAll('.map-product-card')
                .forEach(c => c.classList.remove('bg-primary-subtle'));
            document.querySelector(`.map-product-card[data-index="${index}"]`)
                ?.classList.add('bg-primary-subtle');
        }

        // ── Re-rendre la sidebar (liste des produits/enseignes) ────
        function updateSidebar(products) {
            const list = document.querySelector('.map-sidebar-list');
            if (!list) return;

            if (!products || products.length === 0) {
                list.innerHTML = `<p class="text-muted text-center small py-4">{{ 'No product available'|trans }}</p>`;
                return;
            }

            list.innerHTML = products.map((p, i) => `
                <a href="${p.companyLink}" class="link-offset-2 fw-bold px-2 ms-2 mt-3 link-offset-3-hover link-secondary link-underline link-underline-opacity-0 link-underline-opacity-75-hover d-block">
                    ${esc(p.company)}
                </a>
                <div class="p-2 border-bottom map-product-card position-relative"
                    role="button"
                    data-index="${i}"
                    data-name="${esc((p.company || '').toLowerCase())}"
                    data-company="${esc((p.company || '').toLowerCase())}"
                    onclick="mapFocusMarker(${i})"
                    onmouseover="this.classList.add('bg-light')"
                    onmouseout="this.classList.remove('bg-light')"
                    style="cursor:pointer;">
                    <p class="mb-0 text-muted" style="font-size:.68rem;">
                        <i class="bi bi-geo-alt-fill text-primary"></i> ${esc(p.address)}
                    </p>
                    <span class="position-absolute top-0 end-0 badge rounded-pill ${p.open ? 'bg-success' : 'bg-danger'}">
                        ${p.open ? '{{ 'Opened'|trans }}' : '{{ 'Closed'|trans }}'}
                    </span>
                </div>
            `).join('');
        }

        function setSidebarLoading() {
            const list = document.querySelector('.map-sidebar-list');
            if (!list) return;
            list.innerHTML = `
                <div class="text-center text-muted small py-4">
                    <div class="spinner-border spinner-border-sm me-2" role="status"></div>
                    {{ 'Loading'|trans }}...
                </div>`;
        }

        function setSidebarError() {
            const list = document.querySelector('.map-sidebar-list');
            if (!list) return;
            list.innerHTML = `<p class="text-danger text-center small py-4">{{ 'An error occurred'|trans }}</p>`;
        }

        // ── Applique une réponse JSON du contrôleur (client + produits) ──
        function updateMap(payload) {
            console.log(payload);

            clientLatLng = (payload.client && payload.client.lat !== null && payload.client.lat !== undefined)
                ? [payload.client.lat, payload.client.lng]
                : null;

            renderClient(clientLatLng, payload.radiusKm);
            renderProducts(payload.products || []);
            updateSidebar(payload.products || []);
        }

        // ── Appel asynchrone vers AsyncController (sans recharger la page) ──
        function fetchMapData(url) {
            setSidebarLoading();

            fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                .then(response => {
                    if (!response.ok) {
                        throw new Error('HTTP ' + response.status);
                    }
                    return response.json();
                })
                .then(payload => updateMap(payload))
                .catch(err => {
                    console.error('Map update failed:', err);
                    setSidebarError();
                });
        }

        // ── Sélecteur d'adresse (dropdown) ──────────────────────────
        const addressItems = document.querySelectorAll('#adress-dropdown .dropdown-item');

        addressItems.forEach(function (item) {
            item.addEventListener('click', function (e) {
                e.preventDefault();
                const value = this.dataset.value;

                // Met à jour le label du bouton + l'item actif
                document.getElementById('adressDropdownLabel').textContent = this.textContent.trim();
                addressItems.forEach(i => i.classList.remove('active'));
                this.classList.add('active');

                if (value === '__geoloc__') {
                    if (!navigator.geolocation) {
                        alert("{{ 'Geolocation is not supported by your browser'|trans }}");
                        return;
                    }

                    navigator.geolocation.getCurrentPosition(
                        function (position) {
                            const lat = position.coords.latitude;
                            const lng = position.coords.longitude;

                            // Le gabarit d'URL est généré côté Twig avec des valeurs
                            // factices, puis substitué en JS (les routes Symfony ont
                            // besoin de valeurs réelles à la génération).
                            const urlTemplate = {{ path('map_products_by_coordinates', { latitude: 'LAT_PLACEHOLDER', longitude: 'LNG_PLACEHOLDER', radius: radius })|json_encode|raw }};
                            const url = urlTemplate
                                .replace('LAT_PLACEHOLDER', lat)
                                .replace('LNG_PLACEHOLDER', lng);

                            fetchMapData(url);
                        },
                        function (err) {
                            console.error('Geolocation error:', err.code, err.message);
                            alert("{{ 'Unable to retrieve your location'|trans }}");
                        }
                    );
                    return;
                }

                // Adresse de livraison sélectionnée : l'URL est déjà prête (data-url)
                const url = this.dataset.url;
                if (url) {
                    fetchMapData(url);
                }
            });
        });

        // ── Search filter ─────────────────────────────────────────
        const searchInput = document.getElementById('mapSearchInput');
        if (searchInput) {
            searchInput.addEventListener('input', function () {
                const q = this.value.toLowerCase();
                document.querySelectorAll('.map-product-card').forEach(card => {
                    card.style.display =
                        card.dataset.name.includes(q) || card.dataset.company.includes(q) ? '' : 'none';
                });
            });
        }

        function esc(s) {
            return String(s ?? '')
                .replace(/&/g,'&amp;').replace(/</g,'&lt;')
                .replace(/>/g,'&gt;').replace(/"/g,'&quot;');
        }
    })();
</script>
