<div class="form-group bg-light text-start p-2">
    <div class="validation-rules">
        <div class="rule" id="length-rule">
            <span class="rule-icon is-question"></span>
            <span>{% trans %}10 characters minimum{% endtrans %}</span>
        </div>
        <div class="rule" id="uppercase-rule">
            <span class="rule-icon is-question"></span>
            <span>{% trans %}1 uppercase{% endtrans %}</span>
        </div>
        <div class="rule" id="lowercase-rule">
            <span class="rule-icon is-question"></span>
            <span>{% trans %}1 lowercase{% endtrans %}</span>
        </div>
        <div class="rule" id="special-rule">
            <span class="rule-icon is-question"></span>
            <span>{% trans %}1 special character{% endtrans %} <small class="fw-lighter">(!;?,:%*$@&éàç)</small></span>
        </div>
    </div>
</div>