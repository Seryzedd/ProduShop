{% if cart.empty == false %}
    <div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvasRight" aria-labelledby="offcanvasRightLabel">
        <div class="offcanvas-header">
            <h5 class="offcanvas-title text-muted" id="offcanvasRightLabel">{% trans %}My cart{% endtrans %}</h5>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body">
            {% if cart.items|length > 0 %}
                <p class="text-end">
                    <a href="" class="btn btn-light">
                        {% trans %}Clear my cart{% endtrans %}
                        {{ ux_icon('ic:round-delete') }}
                    </a>
                </p>
                <ul class="list-group list-group-flush">
                    {% for item in cart.items %}
                        <li class="list-group-item">
                            <div class="row align-items-center">
                                <div class="col-lg-4">
                                    {% if item.package.product.image and item.package.product.image.src|length > 0 %}
                                        <img src="{{ item.package.product.image.src }}" class="img-fluid img-thumbnail">
                                    {% endif %}
                                </div>
                                <div class="col-lg-6">
                                    <a class="link-offset-2 link-offset-3-hover link-underline link-underline-opacity-0 link-underline-opacity-75-hover" href="{{ path('app_view_product', {id: item.package.id}) }}">{{ item.package.product.name }}</a>
                                    <p class="mb-0 text-muted">
                                        <small>{{ item.package.name}}</small>
                                    </p>
                                </div>
                                <div class="col-lg-2">
                                    <p class="mb-0 text-end">
                                        <a class="btn btn-light btn-sm">
                                            {{ ux_icon('ic:round-delete') }}
                                        </a>
                                    </p>
                                    <p class="text-end fw-bolder mb-0">x{{ item.quantity }}</p>
                                </div>
                                <div class="col-lg-12">
                                    <p class="text-end text-muted mb-0">{{ (item.package.finalPrice * item.quantity)|number_format(2, ',', ' ') }}{{ ux_icon('ic:round-euro-symbol', {width: '16px', height: '16px'}) }} <small>{% trans %}TTC{% endtrans %}</small></p>
                                </div>
                            </div>
                        </li>
                    {% endfor %}
                    <li class="list-group-item">
                        <div class="d-flex justify-content-between align-items-end">
                            <p class="text-muted mb-0">{% trans %}Total{% endtrans %} :</p>

                            <div class='d-inline-flex align-items-end'>
                                <h5 class="text-end mb-0">{{ cart.total|number_format(2, ',', ' ') }}{{ ux_icon('ic:round-euro-symbol', {width: '22px', height: '22px'}) }}</h5>
                                <p class="mb-0"><small>{% trans %}TTC{% endtrans %}</small></p>
                            </div>
                        </div>
                    </li>
                </ul>

                {% if is_granted('ROLE_USER') %}
                    <p class="text-center mt-4 mb-0">
                        <a class="btn btn-primary mx-auto" href="{{ path('app_cart') }}">
                            {% trans %}Validate my cart{% endtrans %}
                        </a>
                    <p>
                {% else %}
                    <p class="text-center mt-4 mb-0 text-muted">
                        {% trans %}Login to validate cart{% endtrans %}
                    <p>
                {% endif %}
                
            {% else %}
                <h2 class="text-muted text-center">
                    {{ ux_icon('ic:outline-shopping-cart', {height: '48px', width: '48px'}) }}
                    {% trans %}Cart empty{% endtrans %}
                </h2>
            {% endif %}
        </div>
    </div>
{% endif %}