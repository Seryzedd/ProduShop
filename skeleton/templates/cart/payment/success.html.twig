{% extends 'base.html.twig' %}

{% block title %}
    {% trans %}Payment succeed{% endtrans %}
{% endblock %}

{% block breadcrumb %}

    {% set breadcrumb = [
        {
            label: 'My cart',
            route: 'app_cart'
        },
        {
            label: 'Payment',
            route: 'app_cart_payment'
        },
        {
            label: 'Payment succeed',
            route: 'app_payment_success',
            parameters: {'payment': payment.id}
        }
    ] %}
    {{ parent() }}
{% endblock %}

{% block body %}
    <main class="container py-3">
        <div class="text-center mb-5">
            <div class="d-flex text-success align-items-center mx-auto justify-content-center">
                {{ ux_icon('line-md:thumbs-up', {width: '30px', height: '30px'}) }}
                <h1 class="mb-0">{{ 'Payment succeed'|trans }}</h1>
            </div>
            
            <p class="text-muted">{{ 'Purchases summary'|trans }}</p>
        </div>

        <div class="card mx-auto" style="">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span class="fw-semibold">{{ 'Payment summary'|trans }}</span>
                <small class="text-muted">{{ payment.createdAt|date('d/m/Y H:i') }}</small>
            </div>

            <div class="card-body p-0">
                <table class="table table-borderless table caption-top mb-0">
                    <tbody>
                        {% for order in payment.orders %}
                            <tr class="border-bottom">
                                <td class="fw-bold" colspan="2">{{ order.merchant.companyName }}</td>
                                <td class="text-end text-muted" colspan="2">{{ ux_icon('line-md:my-location') }}{{ order.merchant.adress.fullAddress }}</td>
                            </tr>

                            {% for item in order.orderItems %}
                                <tr class="border-bottom">
                                    <td class="ps-4" colspan="2">{{ item.package.product.name }}</td>
                                    <td class="text-center">x{{ item.quantity }}</td>
                                    <td class="text-end">
                                        <strong>
                                            {{ (item.purchase.amount / 100)|number_format(2, ',', ' ') }}
                                        </strong>
                                        <small>EUR</small>
                                    </td>
                                </tr>
                            {% endfor %}
                        {% endfor %}
                    </tbody>
                    <tfoot>
                        <tr class="border-top">
                            <td colspan="3" class="fw-bold">{{ 'Total'|trans }}</td>
                            <td class="text-end fw-bold text-secondary">
                                <h5 class="mb-0">{{ (payment.amount / 100)|number_format(2, ',', ' ') }} <small>EUR</small></h5>
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </main>
{% endblock %}