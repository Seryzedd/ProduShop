<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8">
    <title>Facture {{ invoice_number }}</title>
    <style>
      @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap');

      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

      :root {
        --green:    #75D947;
        --green-l:  #e8f5e1;
        --ink:      #1a1a1a;
        --muted:    #6b7280;
        --line:     #e5e7eb;
        --bg:       #ffffff;
        --surface:  #f9fafb;
      }

      body {
        font-family: 'Inter', sans-serif;
        font-size: 12px;
        color: var(--ink);
        background: var(--bg);
        line-height: 1.6;
      }

      .mr-1 {
        margin-right: 1em;
      }

      .mr-2 {
        margin-right: 2em;
      }

      .ml-1 {
        margin-left: 1em;
      }

      .ml-2 {
        margin-left: 2em;
      }

      .page { max-width: 800px; margin: 0 auto; padding: 48px 56px; }

      /* ── Header ── */
      .header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        padding-bottom: 28px;
        border-bottom: 3px solid var(--green);
        margin-bottom: 36px;
      }

      .logo img { height: 48px; }

      .invoice-meta { text-align: right; }

      .invoice-meta .label {
        font-size: 10px;
        font-weight: 600;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: var(--muted);
      }

      .invoice-meta .number {
        font-size: 22px;
        font-weight: 700;
        color: var(--green);
        font-family: 'JetBrains Mono', monospace;
        margin: 2px 0;
      }

      .invoice-meta .date { font-size: 12px; color: var(--muted); }

      /* ── Badge ── */
      .badge {
        display: inline-block;
        margin-top: 8px;
        padding: 3px 12px;
        border-radius: 20px;
        font-size: 10px;
        font-weight: 600;
        letter-spacing: 1px;
        text-transform: uppercase;
      }
      .badge-paid     { background: var(--green-l); color: var(--green); }
      .badge-pending  { background: #fef3c7; color: #92400e; }
      .badge-failed   { background: #fee2e2; color: #991b1b; }
      .badge-canceled { background: #f3f4f6; color: #6b7280; }

      /* ── Parties ── */
      .parties {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 32px;
        margin-bottom: 36px;
      }

      .party-block { }

      .party-label {
        font-size: 9px;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: var(--green);
        padding-bottom: 6px;
        border-bottom: 2px solid var(--green-l);
        margin-bottom: 10px;
      }

      .party-name { font-weight: 600; font-size: 13px; margin-bottom: 2px; }
      .party-detail { color: var(--muted); font-size: 11px; line-height: 1.8; }
      .party-siret { font-family: 'JetBrains Mono', monospace; font-size: 10px; color: var(--muted); margin-top: 4px; }

      /* ── Marchands ── */
      .merchants-section { margin-bottom: 36px; }

      .section-label {
        font-size: 9px;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: var(--muted);
        margin-bottom: 10px;
      }

      .merchants-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
        gap: 12px;
      }

      .merchant-card {
        background: var(--surface);
        border: 1px solid var(--line);
        border-left: 3px solid var(--green);
        border-radius: 4px;
        padding: 10px 12px;
      }

      .merchant-card .m-name { font-weight: 600; font-size: 12px; margin-bottom: 3px; }
      .merchant-card .m-detail { color: var(--muted); font-size: 10px; line-height: 1.7; }
      .merchant-card .m-siret { font-family: 'JetBrains Mono', monospace; font-size: 9px; color: var(--muted); margin-top: 3px; }

      /* ── Table ── */
      table.items {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 28px;
        font-size: 12px;
      }

      table.items thead tr { background: var(--green); color: white; }

      table.items thead th {
        padding: 9px 12px;
        text-align: left;
        font-size: 10px;
        font-weight: 500;
        letter-spacing: 0.5px;
        text-transform: uppercase;
      }

      table.items thead th:not(:first-child):not(:nth-child(2)) { text-align: right; }

      table.items tbody tr { border-bottom: 1px solid var(--line); }
      table.items tbody tr:last-child { border-bottom: none; }
      table.items tbody tr:nth-child(even) { background: var(--surface); }
      table.items tbody td { padding: 10px 12px; }
      table.items tbody td:not(:first-child):not(:nth-child(2)) { text-align: right; }

      .merchant-tag {
        display: inline-block;
        background: var(--green-l);
        color: var(--green);
        font-size: 9px;
        font-weight: 600;
        padding: 1em;
        border-radius: 10px;
      }

      /* ── Totals ── */
      .totals-wrapper { display: flex; justify-content: flex-end; margin-bottom: 36px; }
      .totals { width: 280px; }

      .totals-row {
        display: flex;
        justify-content: space-between;
        padding: 7px 0;
        border-bottom: 1px solid var(--line);
        font-size: 12px;
      }

      .totals-row:last-child { border-bottom: none; }
      .totals-row .t-label { color: var(--muted); }
      .totals-row .t-value { font-weight: 500; }

      .totals-row.ttc {
        background: var(--green);
        color: white;
        padding: 11px 14px;
        border-radius: 4px;
        margin-top: 4px;
        border-bottom: none;
      }

      .totals-row.ttc .t-label { color: rgba(255,255,255,0.8); font-weight: 600; }
      .totals-row.ttc .t-value { font-size: 15px; font-weight: 700; }

      /* ── Footer ── */
      .footer {
        padding-top: 20px;
        border-top: 1px solid var(--line);
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 10px;
        color: var(--muted);
      }

      .pi-id {
        font-family: 'JetBrains Mono', monospace;
        font-size: 9px;
        background: var(--surface);
        padding: 3px 8px;
        border-radius: 3px;
        border: 1px solid var(--line);
      }
    </style>
  </head>
  <body>
    <div class="page">

      {# ── Header ── #}
      <div class="header">
        <div class="logo">
          <img src="{{ imgToBase64(asset('icons/logo.png')) }}" alt="Lancana">
        </div>
        <div class="invoice-meta">
          <div class="label">{% trans from 'invoice' %}Invoice{% endtrans %}</div>
          <div class="number">{{ invoice_number }}</div>
          <div class="date">{% trans with {'%date%': invoice_date} from 'invoice' %}Issued on %date%{% endtrans %}</div>
          {% if paid_at %}
            <div class="date">{% trans with {'%date%': paid_at} from 'invoice' %}Paid at %date%{% endtrans %}</div>
          {% endif %}
          <div>
            <span class="badge badge-{{ status }}">
              {{ status|trans }}
            </span>
          </div>
        </div>
      </div>

      {# ── Parties ── #}
      <div class="parties">

        {# Client #}
        {% if client %}
          <div class="party-block">
            <div class="party-label">{% trans from 'invoice' %}Customer{% endtrans %}</div>
            <div class="party-name">{{ client.name }}</div>
            <div class="party-detail">
              {{ client.email }}<br>
              {% if client.phone %}{{ client.phone }}{% endif %}
            </div>
          </div>
        {% endif %}

        {# ── Marchands ── #}
        {% if merchants is not empty %}
          <div class="merchants-section">
            <div class="section-label">{% trans from 'invoice' into 'fr' %}Merchants{% endtrans %}</div>
            <div class="merchants-grid">
              {% for merchant in merchants %}
                <div class="merchant-card">
                  <div class="m-name">{{ merchant.name }}</div>
                  <div class="m-detail">
                    {% if merchant.email %}{{ merchant.email }}<br>{% endif %}
                    {% if merchant.phone %}{{ merchant.phone }}<br>{% endif %}
                    {% if merchant.address %}{{ merchant.address }}{% endif %}
                  </div>
                </div>
              {% endfor %}
            </div>
          </div>
        {% endif %}
      </div>

      {# ── Items ── #}
      <div class="section-label">{% trans from 'invoice' %}Order details{% endtrans %}</div>

      <table class="items">
        <thead>
          <tr>
            <th>{% trans from 'invoice' %}Designation{% endtrans %}</th>
            <th>{% trans from 'invoice' %}Merchant{% endtrans %}</th>
            <th>{% trans from 'invoice' %}Quantity{% endtrans %}</th>
            <th>{% trans from 'invoice' %}Unit price{% endtrans %}</th>
            <th>{% trans from 'invoice' %}Tax{% endtrans %}</th>
            <th>{% trans from 'invoice' %}Sub-total HT{% endtrans %}</th>
            <th>{% trans from 'invoice' %}Total TTC{% endtrans %}</th>
          </tr>
        </thead>
        <tbody>
          {% for item in items %}
            <tr>
              <td><strong class="mr-1">{{ item.productName }}</strong><small>{{ item.packageName }}</small></td>
              <td><span class="merchant-tag">{{ item.merchant_name }}</span></td>
              <td>x{{ item.quantity }}</td>
              <td>{{ item.unit_price }} {{ currency }}</td>
              <td>{{ item.tva_rate }}%</td>
              <td>{{ item.subtotal }} {{ currency }}</td>
              <td>{{ item.TTC_price }} {{ currency }}</td>
            </tr>
          {% endfor %}
        </tbody>
      </table>

      {# ── Totals ── #}
      <div class="totals-wrapper">
        <div class="totals">
          <div class="totals-row">
            <span class="t-label">{% trans from 'invoice' %}Total HT{% endtrans %}</span>
            <span class="t-value">{{ amounts.total_ht }} {{ currency }}</span>
          </div>
          <div class="totals-row">
            <span class="t-label">{% trans from 'invoice' %}Tax{% endtrans %}</span>
            <span class="t-value">{{ amounts.tva_amount }} {{ currency }}</span>
          </div>
          <div class="totals-row ttc">
            <span class="t-label">{% trans from 'invoice' %}Total TTC{% endtrans %}</span>
            <span class="t-value">{{ amounts.total_ttc }} {{ currency }}</span>
          </div>
        </div>
      </div>

      {# ── Footer ── #}
      <div class="footer">
        {% set img = "<img style='max-height: 10px;' src='" ~ imgToBase64(asset('icons/logo.png')) ~ "' alt='Lancana'>" %}
        <div>{% trans with {'%img%': img} from 'invoice' %}Generated By %img%{% endtrans %}</div>
        <div class="pi-id">{{ payment_intent_id }}</div>
      </div>

    </div>
  </body>
</html>
